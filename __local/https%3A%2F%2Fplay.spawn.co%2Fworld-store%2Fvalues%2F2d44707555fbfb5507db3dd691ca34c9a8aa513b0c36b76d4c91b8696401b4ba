

import { positionLocal, uv, float, vec3, select, varying, step, mix } from "builtin/tsl";
import { MeshBasicNodeMaterial, DoubleSide } from "builtin/three";
import { tripClock } from "./lib/trip.js";
import { decode, bodyMove, lightOf, skinStripes, skinDiamond, skinChain, truchet, selfCut, finish, colours, shown, win, SEC } from "./serpents-lib.js";

export function material(ctx) {
  const c = tripClock(ctx);
  const s = uv().x, a = uv().y.fract(), b = decode(uv().y);
  const mv = bodyMove(c, b, positionLocal, s);
  const m = new MeshBasicNodeMaterial();
  m.positionNode = mv.p;
  const wp = varying(mv.p), vL = varying(mv.L), vk = varying(mv.k);
  const x = s.mul(vL);

  const deal = c.pick(50, 3);
  const k0 = b.kind;
  const swapped = select(k0.lessThan(1.5), float(1).sub(k0), k0);
  const byRing = select(k0.lessThan(1.5), b.ring, k0);
  const kind = select(deal.lessThan(0.5), k0, select(deal.lessThan(1.5), swapped, byRing));
  const K = colours(c.sec, b.pair.add(b.ring));
  const skin = select(kind.lessThan(0.5), skinStripes(c, x, a, K), select(kind.lessThan(1.5), skinDiamond(c, x, a, K), skinChain(c, x, a, K)));
  const pk = win(c.sec, SEC.peak, 2), tr = truchet(c, x, a).mul(pk).mul(step(0.5, b.pair.mod(2)));
  const col = mix(skin, K.H.mul(1.5), tr);
  const L = lightOf(c, b, s, wp, mv.oc).mul(vk.mul(0.25).add(0.75));
  m.colorNode = finish(c, col, L, x);
  const inWin = win(c.sec, [42.35, 180.35], 0.2);
  const cut = selfCut(c, x, a).mul(inWin).mul(step(0.15, s));
  m.opacityNode = shown(c, "serpents", s).mul(step(0.0, wp.y)).mul(float(1).sub(cut));
  m.alphaTest = 0.5;
  m.side = DoubleSide;
  m.fog = false;
  return m;
}
