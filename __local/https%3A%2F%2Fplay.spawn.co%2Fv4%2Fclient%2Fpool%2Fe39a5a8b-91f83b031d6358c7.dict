var e={staticImports:["./lib.js","./savi-appearance.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,142,83,42,145,118,96,94,6,22,14,122,141,74,55,35,63,90,108,61,54],n:"020000002220s422m44qF70400666m1080GA0800800800CG7EC8G0766ACE2k2EIi2M02G2g7EIi7E012Iw7K002IW2K000Ie7K0002w4E4o3_120220IGM023Kq5EM8AM6Ge2080GA0822002020CG7EC8G07000006iLV0I0c10086gNG0I0c10006y500I0W1012Iy6G0026aVF080GA0800000000CG7EC8G07000006g4V0I0c1023Oi5d1QlZ5m1000S080USG0W1OF0Y108a1g10c1070E0Y1YY17a1u80Qo47000e1c5m1a1U0SW270g1SG0E0Sky2V0USG0W1OF0Y108a1Y30c107000",s:["./lib.js","./savi-appearance.js","globalThis","ctx","bag","self","state","presence","hasSaviHair","clamp01","smoothstep","hair","applySaviAppearance","clearTravelBones","rigBlend"]},exportNames:["hairNeedsHands","hairClipAt","updateSaviHair"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!0,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"0d76f86c-2bu",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./lib.js",names:["clamp01","clearTravelBones","rigBlend","smoothstep"]},{specifier:"./savi-appearance.js",names:["applySaviAppearance","hasSaviHair"]}],fault:null,guardsAt:{loop:45,tail:45,journal:45},initReads:[],memoryless:!0,tops:{split:3018,cuts:[[171,175,["DURATION_MS"],0],[192,196,["TIE_MS"],0],[216,220,["FADE_IN_S"],0],[241,244,["FADE_OUT_S"],0]],data:["DURATION_MS","TIE_MS","FADE_IN_S","FADE_OUT_S"],code:[],calls:[]}};var t=`
import { clamp01, clearTravelBones, rigBlend, smoothstep } from "./lib.js";
import { applySaviAppearance, hasSaviHair } from "./savi-appearance.js";

const DURATION_MS = 8000;
const TIE_MS = 4200;
const FADE_IN_S = 0.35;
const FADE_OUT_S = 0.4;
const bag = (ctx) => ctx.self.state.presence ?? {};
const wanted = (p) => !!(p.lockedIn ?? p.activity?.lockedIn ?? false);
const write = (ctx, hair) => {
  ctx.self.state.presence = { ...bag(ctx), hair };
};

export function hairNeedsHands(ctx) {
  if (!hasSaviHair(ctx)) return false;
  const p = bag(ctx);
  return p.hair?.atMs !== undefined || wanted(p) !== !!p.hair?.locked;
}

export function hairClipAt(hair, now) {
  const durationS = DURATION_MS / 1000,
    tieS = TIE_MS / 1000;
  const elapsedS = clamp01((now - hair.atMs) / DURATION_MS) * durationS;
  const clipS = hair.down ? durationS - elapsedS : elapsedS;
  const weight = smoothstep(0, FADE_IN_S, elapsedS) * (1 - smoothstep(durationS - FADE_OUT_S, durationS, elapsedS));
  return { elapsedS, clipS, weight, locked: clipS >= tieS, glasses: smoothstep(tieS, tieS + FADE_IN_S, clipS), done: now - hair.atMs >= DURATION_MS };
}


export function updateSaviHair(ctx, canStart, playing = false) {
  if (!hasSaviHair(ctx)) {
    if (bag(ctx).hair !== undefined) {
      const rest = { ...bag(ctx) };
      delete rest.hair;
      ctx.self.state.presence = rest;
      ctx.updateChannel("presenceHairUp", null);
    }
    return false;
  }
  const p = bag(ctx),
    target = wanted(p);
  let hair = p.hair ?? { locked: false };
  if (playing) {
    ctx.updateChannel("presenceHairUp", null);
    if (hair.atMs !== undefined || hair.locked !== target) write(ctx, { locked: target });
    applySaviAppearance(ctx, { mode: target ? "locked" : "braided", springs: true });
    return false;
  }
  if (hair.atMs === undefined && hair.locked !== target && canStart) {
    hair = { locked: hair.locked, atMs: ctx.now(), ...(target ? {} : { down: true }) };
    write(ctx, hair);
  }
  if (hair.atMs !== undefined) {
    const at = hairClipAt(hair, ctx.now());
    if (!at.done) {
      applySaviAppearance(ctx, { mode: at.locked ? "locked" : "braided", springs: false, glasses: at.glasses });
      clearTravelBones(ctx);
      ctx.updateIK("head", null);
      ctx.updateChannel("presenceMoment", null);
      const blend = rigBlend(ctx);
      ctx.updateChannel("presenceFloat", { weight: Math.max(0.001, 1 - at.weight), blend });
      ctx.updateChannel("presenceHairUp", { clip: "SaviHairUp", loop: "once", time: hair.down ? DURATION_MS / 1000 : 0, timeAt: hair.atMs, speed: 1, direction: hair.down ? "reverse" : "normal", weight: Math.max(0.001, at.weight), blendIn: 0, blendOut: 0, blend });
      return true;
    }
    hair = { locked: !hair.down };
    write(ctx, hair);
    ctx.updateChannel("presenceHairUp", null);
    ctx.self.state.presence = { ...bag(ctx), nextMomentAtMs: ctx.now() + 1500 };
  }
  applySaviAppearance(ctx, { mode: hair.locked ? "locked" : "braided", springs: true });
  return false;
}
