export const clamp01 = (x) => Math.max(0, Math.min(1, x));
const mix = (a, b, k) => a.map((v, i) => v + (b[i] - v) * k);
function slerp(a, b, t) {
  let dot = a.reduce((sum, v, i) => sum + v * b[i], 0),
    sign = dot < 0 ? -1 : 1;
  dot = Math.min(1, Math.abs(dot));
  if (dot > 0.9995) {
    const q = a.map((v, i) => v + (b[i] * sign - v) * t),
      n = Math.hypot(...q);
    return q.map((v) => v / n);
  }
  const theta = Math.acos(dot),
    den = Math.sin(theta),
    x = Math.sin((1 - t) * theta) / den,
    y = (Math.sin(t * theta) / den) * sign;
  return a.map((v, i) => v * x + b[i] * y);
}
function sample(track, t) {
  const times = track.t,
    size = track.size;
  let a = 0,
    b = times.length - 1;
  if (t <= times[0]) b = 0;
  else if (t >= times[b]) a = b;
  else {
    while (b - a > 1) {
      const m = (a + b) >> 1;
      if (times[m] <= t) a = m;
      else b = m;
    }
  }
  const x = Array.from(track.v.slice(a * size, (a + 1) * size));
  if (a === b) return x;
  const y = Array.from(track.v.slice(b * size, (b + 1) * size)),
    k = (t - times[a]) / (times[b] - times[a]);
  return track.path === "rotation" ? slerp(x, y, k) : mix(x, y, k);
}
function matrix(p, q, s) {
  const [x, y, z, w] = q,
    x2 = x + x,
    y2 = y + y,
    z2 = z + z,
    xx = x * x2,
    xy = x * y2,
    xz = x * z2,
    yy = y * y2,
    yz = y * z2,
    zz = z * z2,
    wx = w * x2,
    wy = w * y2,
    wz = w * z2;
  return [(1 - yy - zz) * s[0], (xy + wz) * s[0], (xz - wy) * s[0], 0, (xy - wz) * s[1], (1 - xx - zz) * s[1], (yz + wx) * s[1], 0, (xz + wy) * s[2], (yz - wx) * s[2], (1 - xx - yy) * s[2], 0, ...p, 1];
}
function multiply(a, b) {
  const result = new Array(16);
  for (let col = 0; col < 4; col++) for (let row = 0; row < 4; row++) result[col * 4 + row] = a[row] * b[col * 4] + a[4 + row] * b[col * 4 + 1] + a[8 + row] * b[col * 4 + 2] + a[12 + row] * b[col * 4 + 3];
  return result;
}


export function sampleSockets(motion, layers) {
  const nodes = motion.nodes,
    locals = nodes.map((n) => ({ translation: [...n.p], rotation: [...n.q], scale: [...n.s] }));
  const totals = nodes.map(() => ({ translation: 0, rotation: 0, scale: 0 }));
  for (const layer of layers) {
    const clip = motion.clips[layer.kind],
      weight = layer.weight ?? 1;
    if (!clip || weight <= 0) continue;
    const t = layer.kind === "idle" ? ((layer.time % clip.duration) + clip.duration) % clip.duration : Math.max(0, Math.min(clip.duration, layer.time));
    for (const track of clip.tracks) {
      const n = track.node,
        path = track.path,
        value = sample(track, t),
        old = totals[n][path],
        k = weight / (old + weight);
      locals[n][path] = old === 0 ? value : path === "rotation" ? slerp(locals[n][path], value, k) : mix(locals[n][path], value, k);
      totals[n][path] += weight;
    }
  }
  const worlds = [];
  function world(i) {
    if (worlds[i]) return worlds[i];
    const n = nodes[i],
      pose = locals[i];
    for (const [path, rest] of [
      ["translation", n.p],
      ["rotation", n.q],
      ["scale", n.s],
    ]) {
      const weight = totals[i][path];
      if (weight > 0 && weight < 1) pose[path] = path === "rotation" ? slerp(rest, pose[path], weight) : mix(rest, pose[path], weight);
    }
    const local = matrix(pose.translation, pose.rotation, pose.scale);
    return (worlds[i] = n.parent < 0 ? local : multiply(world(n.parent), local));
  }
  return Object.fromEntries(
    Object.entries(motion.sockets).map(([name, index]) => {
      const m = world(index);
      return [name, { x: m[12], y: m[13], z: m[14] }];
    })
  );
}


export function frameLayers(kind, seconds, options = {}) {
  const weight = kind === "idle" ? 0 : clamp01(options.weight ?? 1),
    idleTime = options.idleTime ?? seconds;
  return (
    options.layers ??
    (kind === "idle"
      ? [{ kind, time: seconds, weight: 1 }]
      : [
          { kind: "idle", time: idleTime, weight: 1 - weight },
          { kind, time: seconds, weight },
        ])
  );
}


export function frameAxes(options = {}) {
  const origin = options.origin ?? { x: 0, y: 0, z: 0 };
  const rotation = typeof options.rotation === "number" ? options.rotation : (options.rotation?.yaw ?? 0);
  const scale = options.scale ?? 1,
    angle = (rotation * Math.PI) / 180,
    c = Math.cos(angle),
    s = Math.sin(angle);
  const engineVector = (p) => ({ x: (p.x * c + p.z * s) * scale, y: p.y * scale, z: (p.z * c - p.x * s) * scale });
  const enginePoint = (p) => {
    const v = engineVector(p);
    return { x: v.x + origin.x, y: v.y + origin.y, z: v.z + origin.z };
  };
  return { origin, rotation, engineVector, enginePoint };
}
