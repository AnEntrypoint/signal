var e={staticImports:[],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[0,83,42,93,138,143,79,85,120,121,141,61,90,"h__hj.on&&__hj.n(@,`@`,#),",74,"h,__hj.on&&__hj.n(__hjo#,`@`,#),__hjo#",55,35,"l,__hj.on&&__hj.n(__hjo#,`@`,#),__hjv#)",63],n:"0AE2mTm1040G6U040242m1F040G6M006602kBF040G6W1004502o2F040G6K002608rj1l1E2A0800CaK820WW2WW2OA-f1W100Ey1820WW2WW2k2GS0Ig2t10KZZ2G000MuBGO40QmD80G2So100UUG0420Sm1F0UMG0000SkBF0W1W1G0Y1IF0a1q100420SC00W1KG0Y1IF0a1O00000c1w6FOcD0",s:["voice","frequency","value","volume","gain","breath","depth","setup:6","type"]},exportNames:["setup"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!0,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"670a881e-vd",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[],fault:null,guardsAt:{loop:13,tail:20,journal:20},initReads:[],memoryless:!0};var a=`




export function setup({ ctx, out, paused }) {
  const mix = ctx.createGain();
  mix.gain.setValueAtTime(0, ctx.currentTime);
  mix.gain.linearRampToValueAtTime(paused ? 0 : 1, ctx.currentTime + 2);
  mix.connect(out);
  const sources = [];
  for (const [frequency, level] of [
    [349.228, 0.11],
    [523.252, 0.05],
    [698.456, 0.0225],
    [1046.502, 0.01],
  ]) {
    const voice = ctx.createOscillator();
    const volume = ctx.createGain();
    voice.type = "sine";
    voice.frequency.value = frequency;
    volume.gain.value = level;
    voice.connect(volume).connect(mix);
    voice.start();
    sources.push(voice);
    const breath = ctx.createOscillator();
    const depth = ctx.createGain();
    breath.frequency.value = 0.08 + frequency * 0.00004;
    depth.gain.value = level * 0.18;
    breath.connect(depth).connect(volume.gain);
    breath.start();
    sources.push(breath);
  }
  return {
    update(_params, paused) {
      mix.gain.setTargetAtTime(paused ? 0 : 1, ctx.currentTime, 0.15);
    },
    dispose() {
      for (const source of sources) source.stop();
      mix.disconnect();
    },
  };
}
