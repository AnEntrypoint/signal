var e={staticImports:["./savi-motion-data.js","./savi-rig.js","./savi-clips.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,6,20,138,143,79,121,144,41,97,62,90,61,63],n:"040000002220c322-424u226E4y2Q02462K062UE4a7I0044a3E0024w5M0026a5K006uAK008dVGE2A0800CWj1820WW2WW2s1Eee1F0Gby28IEEKY20Gk4DImSk1Ki40Ig10Kw20IY10Ki40MjP2O-30Qe1NOoK0MeEe1Me4W1OY30O6VSmFNOy30",s:["./savi-motion-data.js","./savi-rig.js","sampleSockets","saviMotion","frameAxes","clamp01","frameLayers","sampleSaviFrame:14"]},exportNames:["sampleSaviSockets","sampleSaviFrame"],listExports:[],defaultName:null,reExports:[{specifier:"./savi-clips.js",names:[{local:"saviClips",exported:"saviClips"}]}],starExports:[],vivify:!1,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"39ea2f3b-1bd",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./savi-motion-data.js",names:["saviMotion"]},{specifier:"./savi-rig.js",names:["clamp01","frameAxes","frameLayers","sampleSockets"]}],fault:null,guardsAt:{loop:14,tail:18,journal:28},initReads:["./savi-clips.js"],memoryless:!0,valueExports:["saviClips"]};var i=`

import { saviMotion } from "./savi-motion-data.js";
import { clamp01, frameAxes, frameLayers, sampleSockets } from "./savi-rig.js";

export { saviClips } from "./savi-clips.js";


export function sampleSaviSockets(layers) {
  return sampleSockets(saviMotion, layers);
}


export function sampleSaviFrame(kind, seconds, options = {}) {
  const { origin, rotation, engineVector, enginePoint } = frameAxes(options);
  const weight = kind === "idle" ? 0 : clamp01(options.weight ?? 1);
  const sockets = Object.fromEntries(Object.entries(sampleSaviSockets(frameLayers(kind, seconds, options))).map(([name, p]) => [name, enginePoint({ ...p, y: p.y + saviMotion.groundOffset })]));
  const frame = {
    origin,
    rotation,
    weight: kind === "idle" ? 1 : weight,
    sockets,
    point: (p) => enginePoint({ x: -p[0], y: p[1] + saviMotion.groundOffset, z: -p[2] }),
    vector: (p) => engineVector({ x: -p[0], y: p[1], z: -p[2] }),
    at: (t) => sampleSaviFrame(kind, t, { ...options, weight: 1, layers: undefined }),
  };
  for (const side of ["r", "l"]) {
    const suffix = side.toUpperCase();
    frame[\`palm\${suffix}\`] = sockets[\`savi_palm_\${side}\`];
    const fingers = Object.fromEntries(["index", "middle", "pinky", "thumb"].map((finger) => [finger, Object.fromEntries(["tip", "base", "normal"].map((part) => [part, sockets[\`savi_\${finger}_\${side}_\${part}\`]]))]));
    frame[\`fingers\${suffix}\`] = fingers;
    frame[\`fingertip\${suffix}\`] = fingers.index.tip;
    frame[\`fingertipThumb\${suffix}\`] = fingers.thumb.tip;
    const a = fingers.index.tip,
      b = fingers.thumb.tip;
    frame[\`pinch\${suffix}\`] = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, z: (a.z + b.z) / 2 };
  }
  return frame;
}
