import { dist2 } from "./lib.js";

const point = (v) => (v && Number.isFinite(v.x) && Number.isFinite(v.z) ? { x: v.x, y: Number.isFinite(v.y) ? v.y : 0, z: v.z } : null);


export const navigable = (ctx) => typeof ctx.place.mode !== "string" || ctx.place.mode === "3d";







export function groundAt(ctx, spot, ignore) {
  if (!navigable(ctx)) return null;
  const route = findPath(ctx, spot, spot, ignore ? { maxDrop: 1, ignore } : { maxDrop: 1 });
  if (route.partial) return { partial: true };
  return route.ok && route.points.length ? { at: route.points[route.points.length - 1] } : null;
}


const BODY_M = 1.8;





const OVER_M = 2.3;

const FALL_M = OVER_M + 2;









export function landingOf(ctx, spot, from) {
  if (!navigable(ctx)) return spot;
  const here = groundAt(ctx, spot);
  if (here) return here.partial ? here : openLanding(ctx, here.at);
  const y = point(from)?.y ?? point(ctx.self.feetPosition)?.y;
  if (!Number.isFinite(y)) return null;
  const level = groundAt(ctx, { x: spot.x, y, z: spot.z });
  if (level) return level.partial ? level : openLanding(ctx, level.at);
  return null;
}

















function openLanding(ctx, at) {
  const over = groundAt(ctx, { x: at.x, y: at.y + OVER_M, z: at.z });
  if (over?.partial) return over;
  if (!over || over.at.y < at.y + BODY_M) return at;
  const down = findPath(ctx, over.at, at, { maxDrop: FALL_M });
  if (down.ok) return at;
  if (!down.partial) return down.points.length > 0 ? over.at : at;
  const up = findPath(ctx, at, over.at, { maxDrop: 1 });
  if (up.ok) return at;
  return up.partial ? { partial: true } : over.at;
}







export function company(ctx) {
  const feet = point(ctx.self.feetPosition);
  if (!feet) return null;
  const p = ctx.self.state.presence ?? {};
  const self = ctx.self.id;
  const players = ctx.place.players;


  const stands = (row) => row.id !== self && point(row.feetPosition) !== null;
  const former = p.company ?? {};
  const spoken = p.activity?.userId;
  let person = spoken ? players.find((row) => row.userId === spoken && stands(row)) : undefined;
  if (!person && former.person !== undefined) person = players.find((row) => row.id === former.person && stands(row));
  if (!person) person = players.reduce((best, row) => (!stands(row) ? best : !best || dist2(feet, row.feetPosition) < dist2(feet, best.feetPosition) ? row : best), null);
  if (!person) return null;
  if (person.id !== former.person) {
    ctx.self.state.presence = { ...p, company: { person: person.id } };
  }
  return { id: person.id, at: point(person.feetPosition), feet, distance: dist2(feet, person.feetPosition) };
}
