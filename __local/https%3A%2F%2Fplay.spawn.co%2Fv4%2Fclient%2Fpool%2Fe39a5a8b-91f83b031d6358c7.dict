var l={staticImports:["./toy-math.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,6,18,138,143,85,120,121,63,90],n:"0000020k32YNE2Y8E4W380024260024g160004k7C0024e460026o4m1AC8vTGE2A0800Cq1820WW2WW2a1Ee40G2F08s2020A0800CyD80000CEo50G2F0Ild1OIg7GKa10K6F",s:["./toy-math.js","lerp","xyz","smooth","add","fills","light","openToyLight:17","sampleToyLight:20"]},exportNames:["openToyLight","sampleToyLight"],listExports:[{local:"fills",exported:"fills"},{local:"light",exported:"light"}],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"e2a2abad-q5",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./toy-math.js",names:["add","lerp","smooth","xyz"]}],fault:null,guardsAt:{loop:10,tail:20,journal:20},initReads:[],valueExports:["fills","light"],tops:{split:941,cuts:[[71,246,["fills"],0]],data:["fills"],code:[],calls:[]}};var o=`import { add, lerp, smooth, xyz } from "./toy-math.js";

const fills = [
  { key: "warmLight", color: "#fff1df", intensity: 1.6, offset: [-0.28, 0.4, 0.46] },
  { key: "coolLight", color: "#d9e6ff", intensity: 0.8, offset: [0.4, 0.25, -0.32] },
];
const light = (fill, amount) => ({
  kind: "point",
  color: fill.color,
  intensity: fill.intensity * amount,
  distance: 1.5,
  decay: 2,
  shadow: { enabled: false },
});


export function openToyLight(make) {
  for (const fill of fills) make.part(fill.key, null, { shadow: false, light: light(fill, 0) });
}
export function sampleToyLight(w, t) {
  const palms = lerp(xyz(w.frame.raw.palmR), xyz(w.frame.raw.palmL), 0.5);
  const center = w.frame.local({ x: palms[0], y: palms[1], z: palms[2] });
  const amount = smooth(0, 0.65, t) * w.fade;
  for (const fill of fills) w.pose(fill.key, add(center, fill.offset), undefined, 1, { light: light(fill, amount) });
}

export { fills, light };
