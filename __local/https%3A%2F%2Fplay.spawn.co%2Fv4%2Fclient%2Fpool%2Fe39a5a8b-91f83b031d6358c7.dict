// reads from every heading (one plane seen edge-on vanishes); each plane is a root quad in the base colour
// and a tip triangle in the tip colour, wide at the foot, a point at the top, leaning a little forward. Its
// height, width and colours come from the layer item's params (the engine varies each instance by the item's
// scale range and bends it in the wind). Rewrite the shape here and every blade changes live; delete the
// layer to remove the grass.
function hex(c) {
  var m = /^#([0-9a-f]{6})$/i.exec(String(c || '').trim());
  if (!m) return null;
  var n = parseInt(m[1], 16);
  return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
}

export function geometry(ctx) {
  var p = ctx.params || {};
  var hr = Array.isArray(p.height) ? p.height : [0.45, 0.75];
  var wr = Array.isArray(p.width) ? p.width : [0.08, 0.14];
