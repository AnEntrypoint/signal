}
let edge = size * 1e-5;
let low = floor((vec2f(worldX, worldZ) - edge) / size);
let high = floor((vec2f(worldX, worldZ) + edge) / size);
for (var corner = 0u; corner < 4u; corner++) {
let cellX = low.x + f32(corner & 1u);
