export const SKIN_SCRIPT = "engine/presence/toy-skin.js";
export function skeleton(ctx) {
  const bones = { root: { pivot: [0, 0, 0] } };
  if (ctx.params.part === "sheet") for (let i = 0; i < 5; i++) bones["p" + i] = { parent: "root", pivot: [0, 0, 0] };
  else for (let i = 0; i <= (ctx.params.steps ?? 24); i++) bones["p" + i] = { parent: "root", pivot: [i / (ctx.params.steps ?? 24), 0, 0] };
  return bones;
}
export function geometry(ctx) {
