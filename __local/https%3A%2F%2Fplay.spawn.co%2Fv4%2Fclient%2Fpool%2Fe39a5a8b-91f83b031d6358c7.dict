var e={staticImports:["./toy-math.js","./toy-flight.js","./toy-runtime.js","./toy-shapes.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,6,19,83,20,24,138,143,84,112,88,120,119,121,141,35,63,90,102,33,103],n:"-24UW1Y1Ua1Uc1Ue1W1a1W1c1W1g1Y1Y1e1e1g120i1k1g1Y1e100g1UW1m1o1g1U20U20W120W120m120m120o120o12020UUW1W1m1m1o1o100i1k1g1Edh7Fq12G0800IoD4KS4s1a1s10s1Qs140Qs14000-_3MU020WW2WW2I20Oe90Q03WW2WW2IIqP0KS400000c1000c1000000MU00000800OaC0Q03008I60KS400000x1000x1000000MS00000200Oo50Q03002SwGB0Eo2040G0800Iat14KS400000M000M000000MU00000Y100Oy70Q0300Y1I60KS400000c1000c1000000MU00000200Oi70Q03002I60KS400000x1000x1000000MS00000200O-90Q03002SWw1B0UXm4G000W1gl180Y108Y1OGY1a4Ga1i20a14Fa14Fc107w1y1-10e1m280a1O0W1400Y108Y1OGa1q50a14Fg107w1y100e1m200a1U0W1400Y108a1w50g1070000",s:["./toy-math.js","./toy-flight.js","./toy-runtime.js","./toy-shapes.js","euler","ring","paints","TAU","emissive","smooth","palmFlight","recoil","add","lerp","active","a","b","x","number","Number","y","s","Math","sqrt","c","d","openPlanet:5","i","samplePlanet:19","w","set","atmosphere"]},exportNames:["openPlanet","samplePlanet"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"05743cc2-342",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./toy-math.js",names:["TAU","smooth","active","mix","add","lerp","euler","identity"]},{specifier:"./toy-flight.js",names:["palmFlight","recoil"]},{specifier:"./toy-runtime.js",names:["emissive","ring"]},{specifier:"./toy-shapes.js",names:["paints"]}],fault:null,guardsAt:{loop:52,tail:88,journal:88},initReads:[],memoryless:!0};var a=`import { TAU, smooth, active, mix, add, lerp, euler, identity } from "./toy-math.js";
import { palmFlight, recoil } from "./toy-flight.js";
import { emissive, ring } from "./toy-runtime.js";
import { paints } from "./toy-shapes.js";
export function openPlanet(make) {
  make.part("planet", null);
  make.part("globe", "planet-globe", { parent: "planet" });
  make.part("clouds", "planet-clouds", { parent: "globe", material: { transparent: true, opacity: 0.63, depthWrite: false } });
  for (let i = 0; i < 13; i++) make.part("cities" + i, "planet-cities", { parent: "globe", params: { index: i }, material: { transparent: true, opacity: 0, depthWrite: false } });
  make.part("atmosphere", "orb", { parent: "globe", scale: 0.11, shadow: false, material: { kind: "scripted", script: "engine/presence/toy-rim.js", params: { strength: 0.22 } } });
  make.part("orbit", null, { parent: "planet", q: euler(Math.atan2(0.165, 0.039), 0, 0), scale: [1, Math.hypot(0.039, 0.165) / 0.17, 1] });
  ring(make, "orbitBase", 0.17, 0.00075, { parent: "orbit", material: paints.gold });
  for (let i = 0; i < 32; i++) ring(make, "orbitGlow" + i, 0.17, 0.00125, { parent: "orbit", q: euler(0, 0, Math.PI + (i * TAU) / 32), params: { arc: (TAU / 32) * 0.96, segments: 5 }, material: emissive("#bdeafa", 2.8, 0) });
  for (let i = 0; i < 2; i++) make.part("meridian" + i, "planet-meridian", { parent: "planet", params: { index: i } });
  make.part("latitude", "planet-latitude", { parent: "planet", q: euler(0, 0, 0.34) });
  make.part("moon", "planet-moon", { parent: "planet" });
  ring(make, "moonHalo", 0.031, 0.0008, { parent: "moon", q: euler(0.4, 0, 0), material: emissive("#eadac0", 2, 0.12) });
}
export function samplePlanet(w, t) {
  const activation = smooth(8.6, 11.2, t);
  const flight = palmFlight(w.frame, t, { dropAt: 0.95, catchAt: 1.7, leaveAt: 15.5, goneAt: 16.22, offset: [0, 0.101, 0.015], drift: [-0.24, 0.065] });
  const falling = 1 - smooth(0.95, 1.7, t),
    roll = recoil(t, 1.7, 0.048, 14, 4.6),
    toss = Math.max(0, t - 15.5),
    spin = falling * 1.4 + recoil(t, 1.7, 0.27, 14, 4.6);
  const at = add(flight.point, w.frame.vector([roll, 0, roll * 0.25]));
  w.held("planet", at, 0.95, euler(falling * 0.34 + toss * 1.8, falling * -0.7, spin), { visible: flight.visible });
  w.pose("globe", [0, 0, 0], euler(0, t * 0.115 + smooth(2.15, 2.65, t) * 1.1 + smooth(9.35, 10.3, t) * 0.6, -0.22));
  w.pose("clouds", [0, 0, 0], euler(0, t * 0.045, 0));
  w.set("atmosphere", { material: { kind: "scripted", script: "engine/presence/toy-rim.js", params: { strength: 0.22 + activation * 0.23 } } });
  for (let i = 0; i < 13; i++) w.set("cities" + i, { material: { transparent: true, depthWrite: false, opacity: smooth(0, 1, (activation - i / 18) * 4) } });
  for (let i = 0; i < 32; i++) w.set("orbitGlow" + i, { material: emissive("#bdeafa", 2.8, smooth(0, 1, (activation * 1.25 - i / 32) * 7) * 0.75) });
  for (let i = 0; i < 2; i++) w.pose("meridian" + i, [0, 0, 0], euler(0.22 + i * 0.9, 0.7 + i * 0.6 + activation * Math.sin(t * 0.24 + i) * 0.14, -0.7 + i * 0.4), 0.88 + activation * 0.12);
  const take = smooth(3.7, 5.3, t),
    offered = lerp(w.helper([0.08, 0.27, 0.035], [-0.58, 0.27, 0.635]), w.frame.anchor("pinchR"), take);
  const raised = add(offered, w.frame.vector([0, Math.sin(take * Math.PI) * 0.24, 0]));
  const angle = Math.PI - Math.max(0, t - 7) * 0.9,
    error = active(t, 8, 8.9, 9.3, 10.6);
  const orbit = [Math.cos(angle) * (0.17 + error * 0.09), Math.sin(angle) * (0.039 + error * 0.08), Math.sin(angle) * (0.165 + error * 0.04)];
  const target = w.pointOut("planet", orbit),
    release = smooth(7, 8.6, t);
  const moon = t <= 7 ? raised : add(lerp(w.frame.at(7).anchor("pinchR"), target, release), w.frame.vector([0, Math.sin(release * Math.PI) * 0.07, 0]));
  w.pose("moon", w.pointIn("planet", moon), euler(0, -angle, 0), 1, { visible: t > 1.3 && t < 16.22 });
  w.pose("moonHalo", [0, 0, 0], euler(0.4, 0, t * 0.24), 1, { material: emissive("#eadac0", 2, 0.12 + activation * 0.43) });
}
