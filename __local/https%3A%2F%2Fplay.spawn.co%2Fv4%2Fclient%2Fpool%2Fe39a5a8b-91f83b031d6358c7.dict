  return { joints, weights, normals, uvs };
}
export function collider() {}

export function tubeBones(points) {
  const bones = {};
  for (let i = 0; i < points.length; i++) {
    const direction = unit(sub(points[Math.min(points.length - 1, i + 1)], points[Math.max(0, i - 1)]), [1, 0, 0]);
    bones["p" + i] = { offset: sub(points[i], [i / (points.length - 1), 0, 0]), rotate: boneEuler(between([1, 0, 0], direction)) };
  }
  return bones;
}
export function sheetBones(corners) {
  const rest = [
    [-0.135, 0, 0],
    [0, 0, 0.095],
    [0.135, 0, 0],
    [0, 0.004, -0.11],
    [0, 0.003, 0],
  ];
  return Object.fromEntries(corners.map((p, i) => ["p" + i, { offset: sub(p, rest[i]) }]));
}
