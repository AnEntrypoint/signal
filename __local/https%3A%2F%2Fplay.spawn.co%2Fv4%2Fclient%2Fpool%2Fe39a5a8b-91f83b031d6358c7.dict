var e={staticImports:["builtin/tsl","builtin/three"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[21,0,140,34,55,64,90,35,105,69],n:"0u2i100k2m1224E4s1W10002226w3W108CG0AAF04Ci10C20EgEN0608288G2AAF20Cc20C20G07680Eg100GM0020I806CIc2002Im1002Im1002",s:["builtin/tsl","builtin/three","add","m","colorNode","emissiveNode","opacityNode","transparent","depthWrite","roughness"]},exportNames:["material"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!0,grammar:"f27f8c1f",fileId:"31f70605-j3",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[],fault:null,guardsAt:{loop:3,tail:3,journal:3},initReads:[],memoryless:!0};var a=`const { vec3, uv, time, materialOpacity } = require("builtin/tsl");
const { MeshStandardNodeMaterial } = require("builtin/three");
export function material(ctx) {
  const m = new MeshStandardNodeMaterial();
  const progress = uv().x.add(ctx.param("strand", 0)).div(12);
  const shine = progress
    .mul(Math.PI * 2)
    .sub(time.mul(1.4))
    .cos()
    .max(0)
    .pow(18);
  const base = vec3(0.558, 0.386, 0.863).mul(1.35),
    light = vec3(1, 0.871, 0.61).mul(1.6);
  m.colorNode = base.add(light.sub(base).mul(shine.mul(0.7)));
  m.emissiveNode = m.colorNode;
  m.opacityNode = materialOpacity;
  m.transparent = true;
  m.depthWrite = false;
  m.roughness = 0.35;
  return m;
}
