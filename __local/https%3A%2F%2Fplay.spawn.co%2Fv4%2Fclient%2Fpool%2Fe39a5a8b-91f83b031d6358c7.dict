var e={staticImports:["./toy-light.js","./work-motion.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,20,22,14,142,145,96,37,6,26,122,138,143,79,121,61,90,141,74,55,64],n:"020000002220y222e322E4YGA046a9E88c1668E88k122g1EAq270A00C4y1W12ACc5u100G40G04EM04m1A19Go6W10G00G4I0KM0OQ00G4EM0Gy7G00000000000000000EM0I-8A00SI-GA000Ka37UAU0IAKM0OAU0EM02u2EAw2_2202204w4A00Gc1u220220002000002200EM0Ke400000000000000EO0Gy3F00000000000000000EM02y5EAY3d220220Ce1u144004040EM0Au3t1202204o2A00K-9m20000000000000EM0Kg570000000000000EM0IsBA000Kw200000000000000EM0CW2F22002020EM0Cq1000000000EM02MEMyNt1OZ_4OW12Q0800SoA820WW2WW2u1Ukm1F0Os3020Q0800Sa580000q1UyGF0Oq9720Q0800Sy280000Y1Uab1F0Om4820Q0800So680000q1UqDF0W1ve5e1Y1O0a1Y9N000c1Y780e1GG0g1AF0e1Y1M0a1as17000c1yEO0e1GG0g1AF00Y1M0a1eFV000c1Wa1G0e1GG0g1AF00Y1M0c1K00e1GG0g1GF02Y1M0",s:["./toy-light.js","./work-motion.js","fills","presenceLightScene","presenceLightClearAtMs","globalThis","ctx","workPerformances","bag","k","held","gate","life","clock","light","child","openNativeToyLights:24","releaseNativeToyLights:52","tendPair:69","reconcileNativeToyLights:94","add","delete"]},exportNames:["NATIVE_TOY_RELEASE_MS","openNativeToyLights","releaseNativeToyLights","tendNativeToyLights","reconcileNativeToyLights"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!0,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"e7fd8370-2gz",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./toy-light.js",names:["fills","light"]},{specifier:"./work-motion.js",names:["workPerformances"]}],fault:null,guardsAt:{loop:52,tail:68,journal:68},initReads:[],grows:!0,valueExports:["NATIVE_TOY_RELEASE_MS"],tops:{split:3203,cuts:[[138,142,["NATIVE_TOY_RELEASE_MS"],0],[158,214,["kinds"],0],[446,455,["mayBeLit"],0]],data:["NATIVE_TOY_RELEASE_MS","kinds","mayBeLit"],code:[],calls:[]}};var i=`
import { fills, light } from "./toy-light.js";
import { workPerformances } from "./work-motion.js";
export const NATIVE_TOY_RELEASE_MS = 3000;
const kinds = new Set(["build", "bird", "planet", "garden", "cradle"]);
const nameOf = (fill) => "presence-light-" + fill.key;
const pairIdOf = (ctx, fill) => ctx.self.id + "/" + nameOf(fill);
const fillOf = (ctx, id) => fills.find((fill) => id === pairIdOf(ctx, fill)) ?? null;






const mayBeLit = new Set();

const unlit = (state) => {
  const rest = { ...state };
  delete rest.presenceLightScene;
  delete rest.presenceLightClearAtMs;
  return rest;
};

export function openNativeToyLights(ctx, scene) {
  const work = scene.phase ? workPerformances[scene.kind] : null;
  if (!work && !kinds.has(scene.kind)) return;
  mayBeLit.add(ctx.self.id);
  for (const fill of fills) {
    const bone = work ? work.lights[fill.key] : \`savi_toy_\${scene.kind}_\${fill.key}\`;
    const id = ctx.self.id + "/" + nameOf(fill);
    const child = ctx.getObject(id);
    if (!child) {
      ctx.spawn(nameOf(fill), {
        parent: ctx.self.id,
        attachment: { bone },
        feetPosition: { x: 0, y: 0, z: 0 },
        physics: "none",
        castShadow: false,
        light: light(fill, 1),
        state: { presenceLightScene: scene.id },
        tags: ["presence", "savi-scene-light"],
      });
      continue;
    }
    if (child.attachment?.bone !== bone) ctx.setObjectProperty(id, "attachment", { bone });
    ctx.setObjectProperty(id, "light", light(fill, 1));
    ctx.setObjectState(id, { ...unlit(child.state), presenceLightScene: scene.id });
  }
}


export function releaseNativeToyLights(ctx, scene) {
  const clearAtMs = ctx.now() + NATIVE_TOY_RELEASE_MS;
  for (const fill of fills) {
    const id = ctx.self.id + "/" + nameOf(fill);
    const child = ctx.getObject(id);
    if (child?.state?.presenceLightScene !== scene.id) continue;
    mayBeLit.add(ctx.self.id);
    ctx.setObjectState(id, { ...child.state, presenceLightClearAtMs: clearAtMs });
  }
}


export function tendNativeToyLights(ctx, scene = null) {
  if (mayBeLit.has(ctx.self.id)) tendPair(ctx, scene);
}


function tendPair(ctx, scene) {
  let lit = false;
  for (const fill of fills) {
    const id = pairIdOf(ctx, fill);
    const child = ctx.getObject(id);
    if (!child?.tags?.includes("savi-scene-light")) continue;
    const sceneId = child.state?.presenceLightScene;
    if (sceneId === undefined) continue;
    const clearAtMs = child.state.presenceLightClearAtMs;
    if (clearAtMs !== undefined ? ctx.now() < clearAtMs : scene?.id === sceneId) {
      lit = true;
      continue;
    }
    ctx.setObjectProperty(id, "light", light(fill, 0));
    ctx.setObjectState(id, unlit(child.state));
  }
  if (lit) mayBeLit.add(ctx.self.id);
  else mayBeLit.delete(ctx.self.id);
}






export function reconcileNativeToyLights(ctx, scene = null) {
  tendPair(ctx, scene);
  let clear = true;
  for (const id of ctx._presenceOwnedIds("savi-scene-light")) {
    if (fillOf(ctx, id)) continue;
    const child = ctx.getObject(id);
    if (!child?.tags?.includes("savi-scene-light")) continue;
    ctx.destroy(id);
    if (ctx.getObject(id)) clear = false;
  }
  return clear;
}
