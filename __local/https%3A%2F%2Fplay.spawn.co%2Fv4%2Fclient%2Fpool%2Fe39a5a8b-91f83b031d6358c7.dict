    var sy = h * shoulder;
    var sz = lean * shoulder * shoulder;
    var a = v(-w, 0, 0), b = v(w, 0, 0), c = v(w * 0.8, sy, sz), d = v(-w * 0.8, sy, sz), t = v(0, h, lean);
    // A hex pair shades the root quad at the base and the tip triangle at the tip; any other CSS colour steps base \u2192 tip.
