export function reconcileToys(ctx, scene = ctx.self.state.presence?.scene) {
  let clear = true;
  for (const id of ctx._presenceOwnedIds("savi-toy")) {
    const child = ctx.getObject(id);
    if (!child?.tags?.includes("savi-toy") || (scene && child.tags.includes(scene.id))) continue;
    ctx.destroy(id);
    if (ctx.getObject(id)) clear = false;
  }
  return clear;
}
