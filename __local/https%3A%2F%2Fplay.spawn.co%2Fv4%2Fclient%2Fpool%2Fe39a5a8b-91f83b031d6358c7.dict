const { MeshStandardNodeMaterial } = require("builtin/three");
export function material(ctx) {
  const m = new MeshStandardNodeMaterial();
  const progress = uv().x.add(ctx.param("strand", 0)).div(12);
  const shine = progress
    .mul(Math.PI * 2)
    .sub(ctx.param("clock", 0).mul(1.4))
    .cos()
    .max(0)
    .pow(18);
  const base = vec3(0.558, 0.386, 0.863).mul(1.35),
    light = vec3(1, 0.871, 0.61).mul(1.6);
  m.colorNode = base.add(light.sub(base).mul(shine.mul(0.7)));
  m.emissiveNode = m.colorNode;
  m.opacityNode = ctx.param("opacity", 1);
  m.transparent = true;
  m.depthWrite = false;
  m.roughness = 0.35;
  return m;
}
