var e={staticImports:["builtin/fx"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[128,0,144,41,97,141,34,53,90,55,64],n:"-10G20Ce3F0Ic1G0KAF00GI0G20CoIG0Iu1G0KAF00Gw10G20Ce3F0Ia1G0KAF00GI0G20",s:["builtin/fx","fx","pop","attr","range","curve","curl","drag","up","cone","sphereDir","disc","box","sprite","add","fan"]},exportNames:["effect"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"c9e02b05-3o2",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"builtin/fx",names:["fx","pop","attr","range","curve","curl","drag","up","cone","sphereDir","disc","box","sprite"]}],fault:null,guardsAt:{loop:3,tail:3,journal:21},initReads:[],tops:{split:4754,cuts:[[147,156,["WHITE"],0],[171,209,["KINDS"],0],[225,268,["PHASES"],0],[430,466,["FORM_S"],0],[483,484,["STAND_S"],0],[503,505,["THOUGHT_S"],0]],data:["WHITE","KINDS","PHASES","FORM_S","STAND_S","THOUGHT_S"],code:[],calls:[]}};var s=`






















import { fx, pop, attr, range, curve, curl, drag, up, cone, sphereDir, disc, box, sprite } from 'builtin/fx'

const WHITE = [1, 1, 1]
const KINDS = ['air', 'ground', 'column', 'thought']
const PHASES = ['forming', 'standing', 'burst', 'closing']
const isOklch = (v) => typeof v === 'string' && /^oklch\\(/i.test(v)

const dot = () => sprite({ texture: 'textures/disc', blend: 'alpha' })






const FORM_S = { air: 1.5, ground: 1.5, column: 6 }
const STAND_S = 6
const THOUGHT_S = 20

export function effect(ctx) {
  const kind = KINDS.includes(ctx.params.kind) ? ctx.params.kind : 'air'
  const phase = PHASES.includes(ctx.params.phase) ? ctx.params.phase : 'forming'
  const scale = typeof ctx.params.scale === 'number' && ctx.params.scale > 0 ? ctx.params.scale : 1
  const color = isOklch(ctx.params.color) ? ctx.params.color : WHITE
  return kind === 'thought' ? thought(phase, scale, color) : cloud(kind, phase, scale, color)
}


function cloud(kind, phase, scale, color) {




  const shape =
    kind === 'air'
      ? box({ halfExtents: [0.3 * scale, 0.55 * scale, 0.22 * scale] })
      : kind === 'ground'
        ? disc({ r: 0.4 * scale, lift: 0.1 * scale, jitter: 0.25 })
        : disc({ r: 0.2 * scale, lift: 0.05, jitter: 0.3 })
  const rise = kind === 'column' ? 1.5 : kind === 'ground' ? 0.06 : 0
  const fan = kind === 'column' ? cone(22).mul(range(0.05, 0.25)) : kind === 'ground' ? cone(80).mul(range(0.04, 0.16)) : sphereDir().mul(range(0.03, 0.1))

  const forming = phase === 'forming'
  const standing = phase === 'standing'
  const burst = phase === 'burst'
  const formS = FORM_S[kind] ?? FORM_S.air




  const puffs = pop('puffs', {
    spawn: forming ? { rate: 80 * scale, on: shape, burst: { count: [90, 120] } } : { rate: 0, on: shape },
    window: [0, formS],
    lifetime: kind === 'column' ? [0.7, 1.1] : [1.6, 2.6],
    init: { v: up(rise).mul(range(0.7, 1.15)).add(fan), size: range(0.08, 0.16).mul(scale) },
    accel: drag(kind === 'column' ? 1.1 : 0.9).add(curl(1.2).mul(0.12)),
    size: attr('size').mul(curve([0, 0.15], [0.3, 1], [0.75, 0.9], [1, 0.05])),
    color,
    alpha: 1,
    render: dot(),
  })



  const bubbleRate = forming ? 30 * scale : standing ? 4 * scale : 0
  const bubbles = pop('bubbles', {
    spawn: { rate: bubbleRate, on: shape, ...(forming ? { burst: { count: [10, 14] } } : {}) },
    window: [0, forming ? formS : STAND_S],
    lifetime: [0.6, 1.2],
    init: { v: up(rise * 0.5 + 0.12).mul(range(0.6, 1.2)).add(cone(75).mul(range(0.05, 0.2))), size: range(0.03, 0.07).mul(scale) },
    accel: curl(2.5).mul(0.4).add(drag(0.55)),
    size: attr('size').mul(curve([0, 0], [0.4, 1], [1, 0])),
    color,
    alpha: 1,
    render: dot(),
  })

  if (!burst) return fx(puffs, bubbles)



  const poof = pop('poof', {
    spawn: { rate: 0, on: shape, burst: { count: [50, 70] } },
    lifetime: [0.6, 1.3],
    init: { v: up(0.9).mul(range(0.5, 1.2)).add(cone(85).mul(range(0.3, 0.9))), size: range(0.04, 0.1).mul(scale) },
    accel: curl(2.0).mul(0.5).add(drag(0.9)),
    size: attr('size').mul(curve([0, 0.2], [0.35, 1], [1, 0])),
    color,
    alpha: 1,
    render: dot(),
  })
  return fx(puffs, bubbles, poof)
}






function thought(phase, scale, color) {
  const held = phase === 'forming' || phase === 'standing'
  const shape = disc({ r: 0.045 * scale, lift: 0.03 * scale, jitter: 0.35 })



  const puffs = pop('puffs', {
    spawn: { rate: held ? 0.8 : 0, on: shape, ...(phase === 'forming' ? { burst: { count: [3, 4] } } : {}) },
    window: [0, THOUGHT_S],
    lifetime: [5, 7],
    init: { v: up(0.01).add(cone(60).mul(range(0.002, 0.01))), size: range(0.07, 0.11).mul(scale) },
    accel: drag(2).add(curl(0.8).mul(0.015)),
    size: attr('size').mul(curve([0, 0], [0.12, 1], [0.85, 1], [1, 0])),
    color,
    alpha: 1,
    render: dot(),
  })

  const bubbles = pop('bubbles', {
    spawn: { rate: held ? 1.2 : 0, on: shape },
    window: [0, THOUGHT_S],
    lifetime: [1.0, 1.8],
    init: { v: up(0.09).mul(range(0.7, 1.2)).add(cone(50).mul(range(0.01, 0.04))), size: range(0.02, 0.035).mul(scale) },
    accel: curl(2.5).mul(0.05).add(drag(0.8)),
    size: attr('size').mul(curve([0, 0], [0.4, 1], [1, 0])),
    color,
    alpha: 1,
    render: dot(),
  })

  if (phase !== 'burst') return fx(puffs, bubbles)

  const poof = pop('poof', {
    spawn: { rate: 0, on: shape, burst: { count: [8, 12] } },
    lifetime: [0.4, 0.8],
    init: { v: up(0.3).mul(range(0.6, 1.2)).add(cone(85).mul(range(0.1, 0.3))), size: range(0.02, 0.045).mul(scale) },
    accel: curl(2.0).mul(0.1).add(drag(1.2)),
    size: attr('size').mul(curve([0, 0.2], [0.35, 1], [1, 0])),
    color,
    alpha: 1,
    render: dot(),
  })
  return fx(puffs, bubbles, poof)
}
