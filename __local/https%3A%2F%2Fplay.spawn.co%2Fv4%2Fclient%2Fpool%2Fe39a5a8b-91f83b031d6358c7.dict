  if (tail >= 1.0) { return 1.0; }
  return select(0.0, 1.0, decor_stableThreshold(candidateId, 0x${nC.toString(16)}u) < tail);
}

fn decor_qualityKeep(keep: f32, candidateId: u32) -> f32 {
  if (keep >= 1.0) { return 1.0; }
  return select(0.0, 1.0, decor_stableThreshold(candidateId, 0x${yC.toString(16)}u) < keep);
}

