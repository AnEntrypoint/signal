export const FACE_CLIP_PREFIX = "engine/presence/face#";
export const FACES = ["present", "listening", "thinking", "building", "pleased", "amused"];
export const PLEASED_HOLD_MS = 2400;

export const AMUSED_HOLD_MS = 1600;

export const LISTEN_HOLD_MS = 2800;

export const FACE_BLEND_IN_S = 0.23;
export const FACE_BLEND_OUT_S = 0.3;

export const BUILDING_HOLD_MS = 1200;
const TURN_KINDS = ["waiting", "thinking", "reading", "working", "speaking"];
const WORK_KINDS = ["working", "reading"];

export const FACE_REST = { revision: -1, base: "present", turnOpen: false, workSeen: false, moodUsed: false, listenUntilMs: 0, pleasedUntilMs: 0, amusedUntilMs: 0, buildingUntilMs: 0 };

export const baseFaceOf = (kind) => (WORK_KINDS.includes(kind) ? "building" : kind === "thinking" ? "thinking" : "present");


export function faceStep(prev, activity, nowMs) {
  const record = prev ?? FACE_REST;
  if (!activity || typeof activity.kind !== "string" || typeof activity.revision !== "number" || !(activity.revision > record.revision)) return record;
  const kind = activity.kind;
  const next = { ...record, revision: activity.revision, base: baseFaceOf(kind) };
  if (TURN_KINDS.includes(kind)) {
    if (!record.turnOpen) {
      next.turnOpen = true;
      next.workSeen = false;
      next.moodUsed = false;
      next.listenUntilMs = nowMs + LISTEN_HOLD_MS;
      next.pleasedUntilMs = 0;
      next.amusedUntilMs = 0;
    }
    if (WORK_KINDS.includes(kind)) {
      next.workSeen = true;
      next.buildingUntilMs = Math.max(record.buildingUntilMs, nowMs + BUILDING_HOLD_MS);
    }
  } else {
    next.turnOpen = false;
    if (kind === "done" && record.workSeen) {
      next.pleasedUntilMs = nowMs + PLEASED_HOLD_MS;
      next.amusedUntilMs = 0;
    }
    next.workSeen = false;
  }
  if (activity.mood === "amused" && !next.moodUsed && !(nowMs < next.pleasedUntilMs)) {
    next.moodUsed = true;
    next.amusedUntilMs = nowMs + AMUSED_HOLD_MS;
  }
  return next;
}

export function visibleFace(record, nowMs) {
  const r = record ?? FACE_REST;
  if (nowMs < r.listenUntilMs) return "listening";
  if (nowMs < r.pleasedUntilMs) return "pleased";
  if (nowMs < r.amusedUntilMs) return "amused";
  if (nowMs < r.buildingUntilMs) return "building";
  return r.base;
}

export const faceChannel = (face, nowMs) => ({ clip: FACE_CLIP_PREFIX + face, blend: "override", loop: "loop", weight: 1, blendIn: FACE_BLEND_IN_S, blendOut: FACE_BLEND_OUT_S, time: 0, timeAt: nowMs });
