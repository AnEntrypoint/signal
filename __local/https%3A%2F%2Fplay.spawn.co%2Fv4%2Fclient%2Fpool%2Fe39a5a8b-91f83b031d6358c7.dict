var e={staticImports:["builtin/tsl","builtin/three"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[21,0,141,35,105,69],n:"0y4i100k2m1224E4m1W10006mA808g104606g1008y100206e1008m10020A804CAm1002Am1002",s:["builtin/tsl","builtin/three","m","colorNode","emissiveNode","opacityNode","transparent","depthWrite","roughness"]},exportNames:["material"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!0,grammar:"f27f8c1f",fileId:"208995ee-fn",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[],fault:null,guardsAt:{loop:3,tail:3,journal:3},initReads:[],memoryless:!0};var r=`const { vec3, normalWorld, positionWorld, cameraPosition, materialOpacity } = require("builtin/tsl");
const { MeshStandardNodeMaterial } = require("builtin/three");
export function material() {
  const m = new MeshStandardNodeMaterial();
  const rim = cameraPosition.sub(positionWorld).normalize().dot(normalWorld).clamp(0, 1).oneMinus().pow(3.4);
  m.colorNode = vec3(0.23, 0.58, 0.9);
  m.emissiveNode = vec3(0.23, 0.58, 0.9).mul(2.1);
  m.opacityNode = rim.mul(materialOpacity);
  m.transparent = true;
  m.depthWrite = false;
  m.roughness = 1;
