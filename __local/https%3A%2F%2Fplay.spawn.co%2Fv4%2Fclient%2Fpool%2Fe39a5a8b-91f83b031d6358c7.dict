export const birdTakeoff = 12;
export const birdLanding = 17.5;
export function birdFlightPath(departure, perch, point = (value) => value) {
  return [
    departure,
    ...[
      [0.1, 1.94, 0.69],
      [0.7, 1.72, 0.68],
      [0.65, 0.68, 0.86],
      [-0.25, 0.52, 0.87],
      [-0.73, 1, 0.66],
      [-0.42, 1.64, 0.56],
    ].map(point),
    perch,
  ];
}
export function birdFlightAt(path, time) {
  return curve(path, smooth(birdTakeoff, birdLanding, time));
}
