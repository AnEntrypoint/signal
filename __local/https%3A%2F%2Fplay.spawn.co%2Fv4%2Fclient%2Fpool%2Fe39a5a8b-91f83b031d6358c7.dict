var t={staticImports:["./toy-math.js"],dynamicImports:[],lazyImports:[],textureRefs:[],edits:{k:[123,0,6,144,41,97,63,90],n:"0200020s224E2WBE4o760024s8A0024g560014mA60004y4A0024W360016fZ1O8o1UAo30Cwb1DEw20",s:["./toy-math.js","add","clamp"]},exportNames:["recoil","palmFlight"],listExports:[],defaultName:null,reExports:[],starExports:[],vivify:!1,brackets:!1,requireSugar:!1,grammar:"f27f8c1f",fileId:"2b3abcf7-to",loopBudgetParam:"__sbRt",audioParam:"audio",tailCallTemp:"__sbT",dataExports:null,topLevelLets:[],filings:[],importNames:[{specifier:"./toy-math.js",names:["add","clamp"]}],fault:null,guardsAt:{loop:10,tail:10,journal:13},initReads:[],memoryless:!0};var e=`
import { add, clamp } from "./toy-math.js";

export function recoil(t, contact, amplitude, rate = 17, damping = 6) {
  const dt = t - contact;
  return dt <= 0 ? 0 : amplitude * Math.exp(-damping * dt) * Math.sin(rate * dt);
}

export function palmFlight(frame, t, { dropAt, catchAt, leaveAt, goneAt, offset, drift = [0, 0] }) {
  const palmAt = (time) => add(frame.at(time).anchor("palmL"), frame.vector(offset));
  let point;
  if (t < catchAt) {
    const duration = catchAt - dropAt, elapsed = clamp(t - dropAt, 0, duration);
    const remaining = 1 - elapsed / duration;
    point = add(palmAt(catchAt), frame.vector([drift[0] * remaining, 4.9 * (duration * duration - elapsed * elapsed), drift[1] * remaining]));
  } else if (t < leaveAt) {
    point = add(frame.anchor("palmL"), frame.vector(offset));
  } else {
    const elapsed = clamp(t - leaveAt, 0, goneAt - leaveAt);
    point = add(palmAt(leaveAt), frame.vector([-0.12 * elapsed, 6.8 * elapsed - 4.9 * elapsed * elapsed, 0.18 * elapsed]));
  }
  return { point, visible: t >= dropAt && t < goneAt };
}
`;export{e as default,t as scan};

