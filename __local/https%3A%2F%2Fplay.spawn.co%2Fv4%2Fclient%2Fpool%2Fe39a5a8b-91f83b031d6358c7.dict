export const TOY_GEOMETRY = "engine/presence/toy-geometry.js";
export function nativeFrame(frame) {
  const origin = xyz(frame.point([0, 0, 0]));
  const axes = [
    [1, 0, 0],
    [0, 1, 0],
    [0, 0, 1],
  ].map((p) => xyz(frame.vector(p)));
  return {
    point: (p) => xyz(frame.point(p)),
    vector: (p) => xyz(frame.vector(p)),
    local: (p) => {
      const d = sub(xyz(p), origin);
      return axes.map((axis) => dot(d, axis) / dot(axis, axis));
    },
    anchor: (name) => {
      if (!frame[name]) throw new Error("Missing Savi toy anchor: " + name);
      return xyz(frame[name]);
    },
    localAnchor: (name) => {
      const d = sub(xyz(frame[name]), origin);
      return axes.map((axis) => dot(d, axis) / dot(axis, axis));
    },
    at: (t) => nativeFrame(frame.at(t)),
    raw: frame,
  };
}
export function maker(ctx, handles) {
  const born = [];
  function part(key, shape, opts = {}) {
    const existing = handles.parts[key];
    if (existing && ctx.getObject(existing)) return existing;
    const life = (handles.endsAtMs - ctx.now()) / 1000;
    const name = key === "root" ? handles.prefix : key;
    const parent = key === "root" ? handles.actor : handles.parts[opts.parent ?? "root"];

    handles.parts[key] = parent + "/" + name;
    ctx.self.state.presence.scene.toys = handles;
    const id = ctx.spawn(name, {
      parent,
      feetPosition: vec(opts.at ?? [0, 0, 0]),
      rotation: rotation(opts.q ?? identity),
      scale: typeof opts.scale === "number" ? opts.scale : vec(opts.scale ?? [1, 1, 1]),
      ...(Number.isFinite(life) ? { lifetime: Math.max(0.1, life) } : {}),
      physics: "none",
      castShadow: opts.shadow ?? true,
      receiveShadow: false,
      visible: opts.visible ?? true,
      tags: ["presence", "savi-toy", handles.sceneId],
      ...(shape ? { primitive: { kind: "scripted", script: opts.script ?? TOY_GEOMETRY, params: { part: shape, ...opts.params } } } : {}),
      ...(opts.material ? { material: opts.material } : {}),
      ...(opts.light ? { light: opts.light } : {}),
    });
    handles.parts[key] = id;
    born.push(id);
    ctx.self.state.presence.scene.toys = handles;
    return id;
  }
  return { part, born };
}
export function writer(ctx, handles, frame) {
  const rows = [];
  const state = {};
  const fade = clamp(frame.weight ?? 1);
  const af = nativeFrame(frame);
  const feetInFrame = af.local(ctx.self.worldFeetPosition);

  const rootOffset = { x: feetInFrame[0], y: -feetInFrame[1], z: feetInFrame[2] };
  function set(key, fields) {
    const id = handles.parts[key];
    if (id) rows.push({ id, ...fields });
  }
  function pose(key, at = [0, 0, 0], q = identity, scale = 1, extra = {}) {
    set(key, { feetPosition: vec(at), rotation: rotation(q), scale: typeof scale === "number" ? Math.max(0.00001, scale) : vec(scale.map((n) => Math.max(0.00001, n))), ...extra });
    state[key] = { at, q, scale: (typeof scale === "number" ? [scale, scale, scale] : scale).map((n) => Math.max(0.00001, n)) };
  }
  function held(key, anchor, scale = 1, q = identity, extra = {}) {
    pose(key, af.local(anchor), q, scale * fade, extra);
  }
  function pointIn(key, world) {
    const f = state[key];
    if (!f) throw new Error("Unsampled Savi toy frame: " + key);
    return rotate(sub(af.local(world), f.at), qinv(f.q)).map((n, i) => n / f.scale[i]);
  }
  function pointOut(key, local) {
    const f = state[key];
    return af.point(
      add(
        f.at,
        rotate(
          local.map((n, i) => n * f.scale[i]),
          f.q
        )
      )
    );
  }
  function worldPoint(proto) {
    return af.point(proto);
  }
  function helper(offset, fallback) {
    const wisp = handles.wisp && ctx.getObject(handles.wisp);
    const at = wisp?.worldFeetPosition;
    return at ? add(xyz(at), af.vector(offset)) : af.point(fallback);
  }
  function finish() {
    ctx.batchSetObjectProperties(rows);
  }
  return { set, pose, held, pointIn, pointOut, worldPoint, helper, finish, frame: af, fade, rows, rootOffset };
}
export const emissive = (color, strength = 2, opacity = 1) => ({ color, emissive: color, emissiveIntensity: strength, roughness: 0.24, metalness: 0.1, opacity, transparent: opacity < 1, depthWrite: opacity >= 1 });
export const ring = (make, key, radius, thickness, opts = {}) => make.part(key, "ring", { ...opts, params: { radius, thickness, ...opts.params } });
