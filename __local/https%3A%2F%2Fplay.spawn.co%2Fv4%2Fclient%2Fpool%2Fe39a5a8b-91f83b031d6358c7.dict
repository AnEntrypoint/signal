import { SAVI_BODY_PARTS, SAVI_STATE_PARTS, SAVI_HAIR_MODEL_URL, SAVI_LIGHTER_TWIN_MODEL_URL, SAVI_PREVIOUS_MODEL_URLS, SAVI_HAIR_WHITE, SAVI_HAIR_DYNAMICS, SAVI_BUBBLE_SLOTS, SAVI_CARD_MATERIALS } from "./savi-appearance-data.js";

const NO_PARTS = { hairMaterials: [], braided: [], locked: [], glasses: [], white: [], toys: {} };
const namesOf = (table) => [...(table.hairMaterials ?? []), ...table.braided, ...table.locked, ...table.glasses, ...table.white, ...Object.keys(table.toys)];

const CONTRACT_PARTS = new Set(Object.values(SAVI_BODY_PARTS).flatMap(namesOf));
const applied = new Map();
const given = new Map();
const slotForBone = Object.fromEntries(SAVI_BUBBLE_SLOTS.flatMap((slot) => [slot.legacy, slot.braided, slot.locked].map((bone) => [bone, slot])));
const modelId = (ctx) => (typeof ctx.self.model === "string" ? ctx.self.model : ctx.self.model?.id);

const baseOf = (id) => id.split(/[?#]/, 1)[0];

const isStockBody = (id) => typeof id === "string" && [SAVI_HAIR_MODEL_URL, SAVI_LIGHTER_TWIN_MODEL_URL, ...SAVI_PREVIOUS_MODEL_URLS].includes(baseOf(id));


export function hasSaviHair(ctx) {
  return isStockBody(modelId(ctx)) && ctx.self.primitive == null;
}


function rigOf(id, mode, glasses) {
  if (!isStockBody(id)) return null;
  const rig = SAVI_PREVIOUS_MODEL_URLS.includes(baseOf(id)) ? SAVI_HAIR_MODEL_URL : id,
    table = SAVI_BODY_PARTS[baseOf(rig)] ?? NO_PARTS,

    locked = mode === "locked" && (SAVI_STATE_PARTS[baseOf(rig)]?.hairUp?.length ?? 0) > 0 && table.locked.length > 0,
    alpha = locked ? Math.round(Math.max(0, Math.min(1, glasses)) * 100) / 100 : 0;
  return { rig, table, locked, alpha };
}


const hairPaintOf = (table, parts) => parts[(table.hairMaterials ?? []).find((name) => parts[name] !== undefined)] ?? SAVI_HAIR_WHITE;


const paintsItself = (entry, given) => entry != null && Object.entries(entry).some(([key, value]) => key !== "visible" && key !== "opacity" && key !== "transparent" && (given === undefined || JSON.stringify(value) !== JSON.stringify(given[key])));


function partsOf({ table, locked, alpha }, carried, toys = true, given = undefined) {
  const own = new Set(namesOf(table));
  const parts = {};
  for (const [name, value] of Object.entries(carried ?? {})) if (!CONTRACT_PARTS.has(name) || own.has(name)) parts[name] = value;
  if (toys) Object.assign(parts, table.toys);
  const paint = hairPaintOf(table, parts);
  for (const name of table.white) if (!paintsItself(parts[name], given)) parts[name] = { ...parts[name], ...paint };
  for (const name of table.braided) parts[name] = { ...parts[name], visible: !locked };
  for (const name of table.locked) parts[name] = { ...parts[name], visible: locked };
  for (const name of table.glasses) {
    const { opacity, transparent, ...rest } = parts[name] ?? {};
    parts[name] = locked && alpha < 1 ? { ...rest, visible: alpha > 0, opacity: alpha, transparent: true } : { ...rest, visible: locked };
  }
  return parts;
}


export function saviBodyRow(id, carried, { mode = "braided", glasses = 1, toys = true } = {}) {
  const at = rigOf(id, mode, glasses);
  return at === null ? null : { id: at.rig, parts: partsOf(at, carried, toys) };
}


export function saviBodyLook(id) {
  const table = typeof id === "string" ? SAVI_BODY_PARTS[baseOf(id)] : undefined;
  return table ? partsOf({ table, locked: false, alpha: 0 }, SAVI_CARD_MATERIALS, false) : null;
}

export function applySaviAppearance(ctx, { mode = "braided", springs = true, glasses = 1 } = {}) {
  const self = ctx.self,
    model = self.model,
    worn = modelId(ctx),
    at = rigOf(worn, mode, glasses);
  if (at === null) return;
  const { rig: id, locked, alpha } = at,
    bare = typeof model === "string";
  const previous = applied.get(self.id),
    moved = !previous || previous.id !== id || previous.locked !== locked || previous.alpha !== alpha;

  if (bare || moved || worn !== id) {

    const parts = partsOf(at, bare ? SAVI_CARD_MATERIALS : model.parts, true, bare ? undefined : given.get(self.id));
    given.set(self.id, hairPaintOf(at.table, parts));

    const row = bare ? { id, parts } : { ...model, id, parts };
    if (JSON.stringify(row) !== JSON.stringify(model)) self.model = row;
  }
  if (moved || previous.springs !== springs) {
    self.jiggle = springs ? SAVI_HAIR_DYNAMICS[locked ? "locked" : "braided"] : false;
