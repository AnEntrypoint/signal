fn viewFromUvDepth(uv: vec2<f32>, depth: f32) -> vec3<f32> {
  let v = frame.inverseProj * vec4<f32>(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
  return v.xyz / max(v.w, 1e-30);
}

fn viewZFromDepth(depth: f32, uv: vec2<f32>) -> f32 {
  return -viewFromUvDepth(uv, depth).z;
}

fn screenMarchThickness(viewZ: f32) -> f32 {
  let p = frame.proj[3][3];
  return mix(0.3 + 0.02 * (p - frame.proj[2][3] * viewZ), 0.02 / frame.proj[1][1], p);
}
