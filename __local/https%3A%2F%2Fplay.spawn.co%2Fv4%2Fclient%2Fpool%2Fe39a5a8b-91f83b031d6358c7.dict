// layer and the meadow is gone.
// One blade, feet at y = 0, +Y up: three stacked quads that narrow toward the tip and lean a
// little forward, so a field of them reads as blades, never as crossed rectangles. The vertex
// colour is a base-to-tip gradient the look script may keep or replace. The engine bends the
// blade about its feet with the world's wind (the layer item's \`wind\`); each vertex takes the bend
// in proportion to its height \u2014 ctx.sway(w) sets that fraction by hand for wheat heads and reeds.
export function geometry(ctx) {
  const h = 0.4 + ctx.random() * 0.3;
  const w = 0.03;
  const lean = 0.08;
  for (let s = 0; s < 3; s++) {
    const a = s / 3;
    const b = (s + 1) / 3;
    ctx.color(\`oklch(\${0.5 + 0.3 * a} 0.13 140)\`);
    ctx.quad(-w * (1 - a), h * a, lean * a * a, w * (1 - a), h * a, lean * a * a, w * (1 - b), h * b, lean * b * b, -w * (1 - b), h * b, lean * b * b);
  }
}
