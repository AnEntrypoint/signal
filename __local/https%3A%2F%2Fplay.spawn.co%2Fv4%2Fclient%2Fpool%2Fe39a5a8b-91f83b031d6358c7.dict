    weights.push(1, 0, 0, 0);
    normals.push(...n);
    uvs.push(u, v);
  };
  ctx.color("#ffffff");
  ctx.roughness(0.35);
  if (ctx.params.part === "sheet") {
    const corners = [
      [-0.135, 0, 0],
      [0, 0, 0.095],
      [0.135, 0, 0],
      [0, 0.004, -0.11],
      [0, 0.003, 0],
    ];
    for (let i = 0; i < 4; i++) {
      const ids = [4, i, (i + 1) % 4];
      ctx.tri(...ids.flatMap((n) => corners[n]));
      for (const id of ids) vertex(id + 1, [0, 1, 0], corners[id][0] / 0.27 + 0.5, corners[id][2] / 0.205 + 0.5);
    }
  } else {
    const steps = ctx.params.steps ?? 24,
      sides = ctx.params.sides ?? 5,
      radius = ctx.params.radius ?? 0.0011;
    const v = (i, j) => {
      const angle = (TAU * j) / sides,
        n = [0, Math.cos(angle), Math.sin(angle)];
      return { p: [i / steps, n[1] * radius, n[2] * radius], n, joint: i + 1, u: i / steps, v: j / sides };
    };
    for (let i = 0; i < steps; i++)
      for (let j = 0; j < sides; j++) {
        const vs = [v(i, j), v(i, j + 1), v(i + 1, j + 1), v(i + 1, j)];
        ctx.quad(...vs.flatMap((p) => p.p));
        for (const p of vs) vertex(p.joint, p.n, p.u, p.v);
      }
