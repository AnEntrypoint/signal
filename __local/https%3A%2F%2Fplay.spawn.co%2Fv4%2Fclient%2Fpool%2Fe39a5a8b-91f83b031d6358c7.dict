export function hash01(k, seed = 0) {
  let h = (Math.imul(k | 0, 0x85ebca6b) ^ Math.imul((seed | 0) + 0x165667b1, 0xc2b2ae35)) >>> 0
  h ^= h >>> 15
  h = Math.imul(h, 0x27d4eb2f) >>> 0
  h ^= h >>> 13
  return (h >>> 0) / 4294967296
}


export function seedOf(text) {
  let h = 2166136261
  for (let i = 0; i < text.length; i += 1) {
    h ^= text.charCodeAt(i)
    h = Math.imul(h, 16777619) >>> 0
  }
  return h >>> 0
}








export const sceneToken = (id) => seedOf(String(id)).toString(36)

const smoothT = (t) => t * t * (3 - 2 * t)


export function noise1(x, seed = 0) {
  const i = Math.floor(x)
  const f = x - i
  const a = hash01(i, seed)
  const b = hash01(i + 1, seed)
  return a + (b - a) * smoothT(f)
}


export function wobble(x, seed = 0) {
  return noise1(x, seed) * 2 - 1
}


export function drift(x, seed = 0) {
  return wobble(x, seed) * 0.7 + wobble(x * 2.3 + 11.7, seed + 1) * 0.3
}

export const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v)
export const clamp01 = (v) => clamp(v, 0, 1)
export const lerp = (a, b, t) => a + (b - a) * t
export const smoothstep = (e0, e1, x) => (e1 === e0 ? 0 : smoothT(clamp01((x - e0) / (e1 - e0))))
export const easeInOut = (t) => smoothT(clamp01(t))


export function damp(current, target, halfLifeS, dt) {
  if (!(halfLifeS > 0)) return target
  const k = 1 - Math.pow(0.5, dt / halfLifeS)
  return current + (target - current) * k
}

export const DEG = Math.PI / 180
export const RAD = 180 / Math.PI


export function wrapDeg(deg) {
  let d = ((deg + 180) % 360 + 360) % 360 - 180
  if (d === -180) d = 180
  return d
}


export function yawToward(a, b) {
  return Math.atan2(-(b.x - a.x), -(b.z - a.z)) * RAD
}


export function stepYaw(from, to, dt, maxDegPerS, halfLifeS) {
  const error = wrapDeg(to - from)
  const eased = damp(0, error, halfLifeS, dt)
  const cap = maxDegPerS * dt
  return wrapDeg(from + clamp(eased, -cap, cap))
}

export const dist2 = (a, b) => Math.hypot(b.x - a.x, b.z - a.z)


export function shortOf(from, target, m) {
  const d = dist2(from, target)
  if (d <= m) return { x: from.x, y: target.y, z: from.z }
  const u = (d - m) / d
  return { x: from.x + (target.x - from.x) * u, y: target.y, z: from.z + (target.z - from.z) * u }
}


export function forwardOf(yawDeg) {
  const r = yawDeg * DEG
  return { x: -Math.sin(r), y: 0, z: -Math.cos(r) }
}













export function cardRightOf(body, mode) {
  const sprite = body.sprite
  if (!sprite || body.model) return null
  const art = /[?&]facing=left(?:&|$)/.test(String(sprite.texture ?? "")) ? -1 : 1
  if (mode === "2d-side" || mode === "2d-top") return { x: art, z: 0 }
  if ((sprite.billboard ?? "yaw") !== "none") return null
  const r = (typeof body.yaw === "number" ? body.yaw : 0) * DEG
  return { x: -Math.cos(r) * art, z: Math.sin(r) * art }
}







export function scratchStore() {
  const store = new Map()
  return {
    of(ctx, init) {
      const id = ctx.self.id, run = ctx._presenceRun(), kept = store.get(id)
      if (kept?.run === run) return kept.s
      const s = init()
      store.set(id, { run, s })
      return s
    },
    drop(id) {
      store.delete(id)
    },
  }
}








export function templateOwnsGravity(ctx) {
  const list = ctx.self.behavior
  if (!Array.isArray(list)) return false
  for (const ref of list) if (typeof ref === "string" && !ref.startsWith("engine/presence/")) return true
  return false
}






const TRAVEL_BONES = ["pelvis", "spine_02", "spine_03", "neck_01", "head", "upperarm_l", "upperarm_r", "lowerarm_l", "lowerarm_r", "thigh_l", "thigh_r"]

export function clearTravelBones(ctx) {
  const bones = ctx.self.bones
  for (const name of Object.keys(bones)) if (TRAVEL_BONES.includes(name)) bones[name] = null
}


const GAIT_CHANNELS = new Set(["idle", "walk", "run", "sprint", "_default"])






export function rigBlend(ctx) {
  let gait = false
  for (const key of Object.keys(ctx.self.anim ?? {})) {
    if (key.startsWith("presence")) continue
    if (!GAIT_CHANNELS.has(key)) return null
    gait = true
  }
  return gait ? "override" : null
}
