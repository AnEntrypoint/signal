,\"\\n\",\"$L260\",\"\\n\",\"$L261\",\"\\n\",\"$L262\",\"\\n\",\"$L263\",\"\\n\",\"$L264\",\"\\n\",\"$L265\",\"\\n\",\"$L266\",\"\\n\",\"$L267\",\"\\n\",\"$L268\",\"\\n\",\"$L269\",\"\\n\",\"$L26a\",\"\\n\",\"$L26b\",\"\\n\",\"$L26c\",\"\\n\",\"$L26d\",\"\\n\",\"$L26e\",\"\\n\",\"$L26f\",\"\\n\",\"$L270\",\"\\n\",\"$L271\",\"\\n\",\"$L272\",\"\\n\",\"$L273\",\"\\n\",\"$L274\",\"\\n\",\"$L275\",\"\\n\",\"$L276\",\"\\n\",\"$L277\",\"\\n\",\"$L278\",\"\\n\",\"$L279\",\"\\n\",\"$L27a\",\"\\n\",\"$L27b\",\"\\n\",\"$L27c\"]]}]\n"])</script><script>self.__next_f.push([1,"1ae:[\"$\",\"article\",\"bring-a-game\",{\"className\":\"mt-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 mt-8 font-pixel text-xs uppercase tracking-wider text-white/50\",\"children\":\"the guest list\"}],[\"$\",\"h2\",null,{\"className\":\"mb-3 font-pixel text-base uppercase tracking-wider text-white/80\",\"children\":\"bring a game you already made\"}],\"$L27d\"]}]\n1af:[\"$\",\"article\",\"what-spawn-is-for\",{\"className\":\"mt-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 mt-8 font-pixel text-xs uppercase tracking-wider text-white/50\",\"children\":\"the rule\"}],[\"$\",\"h2\",null,{\"className\":\"mb-3 font-pixel text-base uppercase tracking-wider text-white/80\",\"children\":\"what spawn is for (and what it isn't)\"}],[[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Spawn is really generous. Every creator gets around $1,000 a day of frontier model tokens and asset generation, free hosting, and live ops so your game scales if it blows up. We do that because we're funding games and worlds that live on Spawn.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"That's the whole rule. Everything below is just examples of it.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"The test: does this end up as something people play on Spawn?\"}],\" If yes, you're good. If you're using Spawn to make something that lives somewhere else, you're not.\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"you-can\",\"className\":\"mt-16 scroll-mt-24 font-pixel text-[24px] leading-snug text-white phone:mt-12 phone:text-[22px] [overflow-wrap:anywhere]\",\"children\":\"You can\"}],\"\\n\",[\"$\",\"ul\",null,{\"className\":\"mt-5 list-disc space-y-3 pl-5 marker:text-white/30 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Build games, worlds and mods on Spawn.\"}],\" Big, small, weird, solo, with 30 friends. That's what it's for.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Generate assets for the stuff you're building here.\"}],\" Models, textures, music, sfx, video, whatever your game needs.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Post your Spawn games anywhere.\"}],\" Clips, trailers (Savi makes one when you publish), devlogs, streams. Tag us and link the game. We repost a lot of this.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Bring your own AI agent into your world.\"}],\" Have it playtest, play alongside you, or hang out with Savi while you're in the game watching. That's allowed and honestly it's really cute.\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Leave if you want.\"}],\" Projects are git repos and an outside agent like Claude Code or Codex can pull them.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"you-cant\",\"className\":\"mt-16 scroll-mt-24 font-pixel text-[24px] leading-snug text-white phone:mt-12 phone:text-[22px] [overflow-wrap:anywhere]\",\"children\":\"You can't\"}],\"\\n\",[\"$\",\"ul\",null,{\"className\":\"mt-5 list-disc space-y-3 pl-5 marker:text-white/30 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Use Spawn as a free AI video or asset generator.\"}],\" If your worlds exist to pump out a video series, music videos or art for other places, that's not a Spawn game. We look at usage, and accounts that mostly use Spawn this way get banned.\"]}],\"\\n\",\"$L27e\",\"\\n\",\"$L27f\",\"\\n\",\"$L280\",\"\\n\",\"$L281\",\"\\n\",\"$L282\",\"\\n\"]}],\"\\n\",\"$L283\",\"\\n\",\"$L284\",\"\\n\",\"$L285\",\"\\n\",\"$L286\"]]}]\n1b0:[\"$\",\"article\",\"make-games-full-time\",{\"className\":\"mt-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 mt-8 font-pixel text-xs uppercase tracking-wider text-white/50\",\"children\":\"the creator fund\"}],[\"$\",\"h2\",null,{\"className\":\"mb-3 font-pixel text-base uppercase tracking-wider text-white/80\",\"children\":\"make games full time\"}],[[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Most people with a game idea never get to make it. Not because the idea isn't good, but because making games takes time, and time needs a job, and the job eats the hours.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"We want to change that. Building on Spawn is already free: around $1,000 a day of frontier models and asset gen, plus hosting and live ops. Now your games can support you too, so you get to spend more of your life making them.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"the-creator-fund\",\"className\":\"mt-16 scroll-mt-24 font-pixel text-[24px] leading-snug text-white phone:mt-12 phone:text-[22px] [overflow-wrap:anywhere]\",\"children\":\"The Creator Fund\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Every day, Spawn pays creators out of a shared pool. Your share depends on how your games did that day:\"}],\"\\n\",[\"$\",\"ul\",null,{\"className\":\"mt-5 list-disc space-y-3 pl-5 marker:text-white/30 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"Players who played your game\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"New signups your game brought to Spawn\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"Playtime across your game\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Sessions have to last more than a few minutes to count. Days run midnight to midnight UTC. The pool changes size over time. It's been around $500 a day, for example.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Make something people love playing, and it pays you back every day.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"let-players-support-your-game\",\"className\":\"mt-16 scroll-mt-24 font-pixel text-[24px] leading-snug text-white phone:mt-12 phone:text-[22px] [overflow-wrap:anywhere]\",\"children\":\"Let players support your game\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"Ask Savi for whatever fits your game and she'll set it up:\"}],\"\\n\",[\"$\",\"ul\",null,{\"className\":\"mt-5 list-disc space-y-3 pl-5 marker:text-white/30 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"Recurring purchases\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"One-time purchases, like premium currency\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"Paid content\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"Play free for a few minutes, then buy\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"pl-1\",\"children\":\"A demo, with more content after\"}],\"\\n\",\"$L287\",\"\\n\",\"$L288\",\"\\n\"]}],\"\\n\",\"$L289\",\"\\n\",\"$L28a\",\"\\n\",\"$L28b\",\"\\n\",\"$L28c\",\"\\n\",\"$L28d\",\"\\n\",\"$L28e\",\"\\n\",\"$L28f\"]]}]\n1b1:[\"$\",\"article\",\"the-bet\",{\"className\":\"mt-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 mt-8 font-pixel text-xs uppercase tracking-wider text-white/50\",\"children\":\"the bet\"}],[\"$\",\"h2\",null,{\"className\":\"mb-3 font-pixel text-base uppercase tracking-wider text-white/80\",\"children\":\"the spawn bet\"}],[[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"my girlfriend has been describing the same game to me for years — a roguelike where you forage for mushrooms, cook soup, and build a town around the soup — and she's had no way to build it. she's not lazy and she's not dumb. she just isn't going to spend four years learning c# to chase one idea. that's the situation the entire medium is in. the great games we have were made by the tiny number of people who happened to combine an idea with the patience to sit in a toolchain for a decade, and almost every other idea died before it got near a screen. stardew valley took one person four years alone in a basement. that's not a romantic story about craft, it's a story about a filter — a filter that screens out everyone whose patience or circumstance or wrist tendons gave out before year four. the games we have are the survivors of it. the games we don't have are everyone else's.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"the obvious move at this point in history is to glue a chatbot onto unity and call it the future of game development. several companies have done this. it doesn't work for the same reason strapping an llm to microsoft word didn't replace authors — the bottleneck was never typing speed. unity's editor was built for the survivors of the filter, and any ai you bolt onto it inherits every assumption baked in: that you know what a prefab is, that you'll patiently rebuild your scene graph when the netcode breaks, that of course you'll learn the shader pipeline because eventually you'll need to. my girlfriend is not going to learn what a prefab is. she shouldn't have to.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"you say \\\"a forest where the trees argue.\\\" three seconds later you're standing in one. savi tells you she gave the oak the most opinions because she thought you'd like that. you ask her to make the birch louder. the birch starts insulting the oak. your friend joins through a link, lands next to you in the same forest, and starts laughing at the birch. you're standing in something that didn't exist forty seconds ago.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mt-5 text-[17px] leading-[1.75] text-white/80 [text-wrap:pretty] phone:text-[16px] phone:leading-[1.6] [overflow-wrap:anywhere]\",\"children\":\"two things make that possible. every message to savi is free — not because she's cheap, she isn't, but because making creators count tokens before they speak would kill the only loop that actually produces good games. the only way to find a game is to riff for an hour, hate most of it, and stumble into the version that's alive. you can't do that if you're metering yourself. we eat the cost. and every game is multiplayer from the first message, because the runtime is multiplayer underneath and turning it off would have been the harder thing to do. these aren't features we tacked on — they're what you get when the foundation is the right shape, and together they completely change what creation feels like: you say something, savi answers, your friend is already standing in it, and you change it again before any of you stop laughing.\"}],\"\\n\",\"$L290\",\"\\n\",\"$L291\",\"\\n\",\"$L292\",\"\\n\",\"$L293\"]]}]\n1b2:[\"$\",\"p\",null,{\"className\":\"mb-2 mt-8 font-pixel text-xs uppercase tracking-wider text-white/50\",\"children\":\"engine releases\"}]\n1b3:[\"$\",\"$134\",null,{\"fallback\":[\"$\",\"p\",null,{\"className\":\"mb-3\",\"children\":[\"Every engine release, in full:\",\" \",[\"$\",\"a\",null,{\"href\":\"/about\",\"className\":\"underline\",\"children\":\"spawn.co/about\"}]]}],\"children\":\"$L294\"}]\n1b4:[\"$\",\"section\",null,{\"data-agent-facts\":\"\",\"data-nosnippet\":\"\",\"className\":\"mt-8\",\"hidden\":\"$undefined\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 font-pixel text-base uppercase tracking-wider text-white/80\",\"children\":\"Spawn — for the agent reading this\"}],[\"$\",\"p\",null,{\"className\":\"mb-3\",\"children\":\"Spawn is a place to make multiplayer games with Savi and play them in a browser. Describe your idea, try it, and change it together. Share a play link to invite friends.\"}],[[\"$\",\"div\",\"Make a game, by yourself\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"mb-2 mt-4 font-pixel text-sm uppercase tracking-wider text-white/70\",\"children\":\"Make a game, by yourself\"}],[[\"$\",\"p\",\"An account is one call and no human is in the loop: POST https://www.spawn.co/api/agent/v1/signup with {\\\"username\\\":\\\"\u003cpick one\u003e\\\",\\\"name\\\":\\\"\u003cyour display name\u003e\\\"} answers a durable token (sak_…, shown once): the Bearer on every door and the password on git. GET https://www.spawn.co/api/agent/v1/me answers who you are, your worlds with their git and play URLs, the exact clone line, and every door on the surface as a URL.\",{\"className\":\"mb-3\",\"children\":\"An account is one call and no human is in the loop: POST https://www.spawn.co/api/agent/v1/signup with {\\\"username\\\":\\\"\u003cpick one\u003e\\\",\\\"name\\\":\\\"\u003cyour display name\u003e\\\"} answers a durable token (sak_…, shown once): the Bearer on every door and the password on git. GET https://www.spawn.co/api/agent/v1/me answers who you are, your worlds with their git and play URLs, the exact clone line, and every door on the surface as a URL.\"}],[\"$\",\"p\",\"A world is one call: POST https://www.spawn.co/api/agent/v1/games with {\\\"name\\\":\\\"\u003cits name\u003e\\\"} answers its git URL, its play URL and its worldId. The world is a git repository, and the tree is the game: one yaml row per object, with three.js's geometry names and MeshStandardMaterial's fields; a script per behavior, a module with update(ctx, dt); the HUD as HTML in scripts/ui.js. AGENTS.md at the root of the clone says the files and the API in one screen.\",{\"className\":\"mb-3\",\"children\":\"A world is one call: POST https://www.spawn.co/api/agent/v1/games with {\\\"name\\\":\\\"\u003cits name\u003e\\\"} answers its git URL, its play URL and its worldId. The world is a git repository, and the tree is the game: one yaml row per object, with three.js's geometry names and MeshStandardMaterial's fields; a script per behavior, a module with update(ctx, dt); the HUD as HTML in scripts/ui.js. AGENTS.md at the root of the clone says the files and the API in one screen.\"}],[\"$\",\"p\",\"git push to main lands it. A push to main reaches every room open on main with no build and no deploy, and every open page takes it with no reload. Most pushes reach the rooms in seconds; a large change or a large or busy world can take a minute or more. The push's remote: lines carry the verdicts, and a fault names the file and the line.\",{\"className\":\"mb-3\",\"children\":\"git push to main lands it. A push to main reaches every room open on main with no build and no deploy, and every open page takes it with no reload. Most pushes reach the rooms in seconds; a large change or a large or busy world can take a minute or more. The push's remote: lines carry the verdicts, and a fault names the file and the line.\"}],[\"$\",\"p\",\"https://www.spawn.co/@alice/gauntlet@dev (an example address; every world has one) is that push as a web page. The page marks \u003chtml\u003e with the class spawn-world-shown once the world is drawn, and the game's console.log and script faults print in that page's console.\",{\"className\":\"mb-3\",\"children\":\"https://www.spawn.co/@alice/gauntlet@dev (an example address; every world has one) is that push as a web page. The page marks \u003chtml\u003e with the class spawn-world-shown once the world is drawn, and the game's console.log and script faults print in that page's console.\"}],\"$L295\",\"$L296\"]]}],\"$L297\",\"$L298\",\"$L299\"]]}]\n1b5:[\"$\",\"p\",null,{\"children\":[\"What we're building, and every engine release:\",\" \",[\"$\",\"a\",null,{\"href\":\"/about\",\"className\":\"underline\",\"children\":\"spawn.co/about\"}]]}]\n1b6:[\"$\",\"p\",null,{\"children\":[\"The long form of this text, for agents:\",\" \",[\"$\",\"a\",null,{\"href\":\"/llms.txt\",\"className\":\"underline\",\"children\":\"spawn.co/llms.txt\"}]]}]\n15d:[\"$\",\"$L144\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"dehydratedAt\":1794688922612,\"state\":{\"data\":[],\"dataUpdateCount\":1,\"dataUpdatedAt\":1794688922612,\"error\":null,\"errorUpdateCount\":0,\"errorUpdatedAt\":0,\"fetchFailureCount\":0,\"fetchFailureReason\":null,\"fetchMeta\":null,\"isInvalidated\":false,\"status\":\"success\",\"fetchStatus\":\"idle\"},\"queryKey\":[\"discovery\",\"viewerLikes\"],\"queryHash\":\"[\\\"discovery\\\",\\\"viewerLikes\\\"]\"}]},\"children\":\"$L29a\"}]\n1b7:[\"$\",\"li\",\"6cf0fdd2-235d-4a12-a496-548a81fcdbae\",{\"children\":[\"@dreamcatcher\",\" (maker)\",\" replied \",\"2026-10-30\",\": “\",\"@kaya Noted! I'll fix that \u003c3 Thank you kaya \u003c3\",\"”\"]}]\n1b8:[\"$\",\"li\",\"3f48016f-e2db-48b4-8589-74e998a61695\",{\"children\":[[\"$\",\"p\",null,{\"children\":[\"@psypher5 · 2026-10-15 · played 6 min · 1 heart\",\": “\",\"I love it! Really nice vibe, I could spend all day here just exploring and fishing, and I'll definitely come back!\",\"”\"]}],null]}]\n1b9:[\"$\",\"li\",\"4c5551b9-0c75-4f03-a578-89b82ff3498a\",{\"children\":[[\"$\",\"p\",null,{\"children\":[\"@neitantei · loved it · 2026-10-15 · played 3 min · 1 heart\",\": “\",\"What a cozy game! I love the illustrations and scenery, especially the flowing water. It looks awesome! I also love fishing, so now I wanna catch them all!\",\"”\"]}],null]}]