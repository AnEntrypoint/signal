

import { BODIES, frame, tubeR, codeOf } from "./serpents-curve.js";
export function geometry(ctx) {
  const far = ctx.lod >= 3, RN = far ? 24 : 48, SN = far ? 8 : 14;
  const uvs = [], normals = [];
  BODIES.forEach((b, bi) => {
    const code = codeOf(bi), rings = [];
    for (let i = 0; i <= RN; i++) {
      const s = i / RN, F = frame(b, s), r = tubeR(b, s), row = [];
      for (let j = 0; j <= SN; j++) {
        const a = (j / SN) * Math.PI * 2, ca = Math.cos(a), sa = Math.sin(a);
        const n = [F.N[0] * ca + F.B[0] * sa, F.N[1] * ca + F.B[1] * sa, F.N[2] * ca + F.B[2] * sa];
        row.push({ p: [F.P[0] + n[0] * r, F.P[1] + n[1] * r, F.P[2] + n[2] * r], n, u: s, v: code + (j / SN) * 0.999 });
      }
      rings.push(row);
    }
    const put = (q) => { uvs.push(q.u, q.v); normals.push(q.n[0], q.n[1], q.n[2]); };
