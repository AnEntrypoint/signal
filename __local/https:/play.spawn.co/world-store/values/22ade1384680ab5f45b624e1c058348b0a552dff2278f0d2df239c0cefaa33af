    for (let i = 0; i < RN; i++) for (let j = 0; j < SN; j++) {
      const a = rings[i][j], c = rings[i][j + 1], d = rings[i + 1][j + 1], e = rings[i + 1][j];
      tri(a, d, c); tri(a, e, d);
    }
  });
  return { uvs, normals };
}
export function collider() { return null; }
