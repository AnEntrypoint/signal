# name: the game's name: fill it once you know what this is. description: one line for the box art.
name: "Signal Stage"
description: "A neon motion-graphics stage: hit roll and the camera flies the shot list to the beat."
camera: templates/camera.js#camera
lighting: scripts/lighting.js
defaultPlace: main
engine:
  behaviors:
    - scripts/arrival.js
  networking:
    mode: multiplayer
  ui:
    theme:
      font: Geist Pixel Square
inputs:
  actions:
    cine:
      keys:
        - p
      gamepad: y
    jump:
      keys:
        - space
      gamepad: a
    ownSong:
      gamepad: false
  axes:
    moveX:
      keys: a/d
    moveZ:
      keys: s/w
player: templates/player.js#player
ui:
  render: scripts/ui.js
# nametag: the tag over other players' heads: this file, yours to edit: export default function (ctx, tag) { return html }, the shape ui.js has.
nametag: ui/nametag.js
authoring:
  starter:
    id: 3d
buyables:
  own-track:
    name: Play your own song
    description: Your song becomes the next roll. The whole room hears it, and the show reads its beat and drops.
    priceSpoins: 50
    imageUrl: /cdn/value.f1b763361a1679ad4eed5eaeb23d75fea5b51bfb9377ed5676dec1ce379c1d7e.png
    onPurchase: scripts/buyables/own-track.js
