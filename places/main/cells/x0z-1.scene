# spawn-scene v2 yaml x0z-1
sun-eye:
  castShadow: false
  feetPosition: {x: 0, y: 62, z: -90}
  id: sun-eye
  material: {kind: scripted, params: {"on": 0, t0: 0}, script: scripts/sun-disc.js}
  physics: none
  primitive: {kind: scripted, params: {h: 27, w: 27, z: 0}, script: scripts/sun-quad-geo.js}
  receiveShadow: false
  rotation: {include: [yaw, pitch], lookAt: {x: 0, y: 15, z: 20}}
  tags: [trip, sun]
