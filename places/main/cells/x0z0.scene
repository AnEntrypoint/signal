# spawn-scene v2 yaml x0z0
director:
  audience: all
  behavior: scripts/stage.js
  feetPosition: {x: 0, y: 0, z: 0}
  id: director
  state: {}
  tags: [stage]
eye:
  feetPosition: {x: 0, y: 0, z: -34}
  id: eye
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 3, height: 32, kind: box, width: 34}
  tags: [blueprint]
field:
  castShadow: false
  feetPosition: {x: 0, y: 0.02, z: 0}
  id: field
  material: {kind: scripted, params: {"on": 1, t0: 1595.5983333333334}, script: scripts/field-mandala.js}
  physics: none
  primitive: {kind: scripted, script: scripts/field-disc.js}
  receiveShadow: false
  tags: [trip, field]
field-orbs:
  castShadow: false
  feetPosition: {x: 0, y: 0, z: 0}
  id: field-orbs
  material: {kind: scripted, params: {"on": 1, t0: 1595.5983333333334}, script: scripts/field-orbs-mat.js}
  physics: none
  primitive: {kind: scripted, script: scripts/field-orbs.js}
  receiveShadow: false
  tags: [trip, field]
field-stalks:
  castShadow: false
  feetPosition: {x: 0, y: 0.02, z: 0}
  id: field-stalks
  material: {kind: scripted, params: {"on": 1, t0: 1595.5983333333334}, script: scripts/field-stalks-mat.js}
  physics: none
  primitive: {kind: scripted, script: scripts/field-stalks.js}
  receiveShadow: false
  tags: [trip, field]
stage-floor:
  feetPosition: {x: 0, y: -0.3, z: 0}
  id: stage-floor
  material: {color: "#020206", metalness: 0, roughness: 0.9}
  physics: static
  primitive: {height: 0.3, kind: cylinder, radialSegments: 64, radiusBottom: 140, radiusTop: 140}
  tags: [stage]
  visible: true
