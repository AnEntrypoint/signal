# spawn-scene v2 yaml x0z0
director:
  audience: all
  behavior: scripts/stage.js
  feetPosition: {x: 0, y: 0, z: 0}
  id: director
  state: {}
  tags: [stage]
eye:
  castShadow: false
  feetPosition: {x: 0, y: 15, z: -34}
  id: eye
  material: {kind: scripted, params: {"on": 1, t0: 1654.5649999999996}, script: scripts/eye-iris.js}
  physics: none
  primitive: {kind: scripted, params: {inner: 5, outer: 15, segments: 128, z: 0}, script: scripts/eye-iris-geo.js}
  receiveShadow: false
  tags: [trip, eye]
eye-beads:
  castShadow: false
  feetPosition: {x: 0, y: 15, z: -34}
