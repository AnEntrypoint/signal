

export function geometry(ctx) {
  const uvs = [];
  const tri = (a, b, c) => { ctx.tri(a[0], a[1], a[2], b[0], b[1], b[2], c[0], c[1], c[2]); uvs.push(a[3], a[4], b[3], b[4], c[3], c[4]); };
  const far = ctx.lod >= 3, S = far ? 3 : 5, r0 = 0.045, r1 = 0.022;
  for (let s = 0; s < S; s++) {
    const a = (s / S) * 6.2831853, b = ((s + 1) / S) * 6.2831853;
    const A0 = [Math.cos(a) * r0, 0, Math.sin(a) * r0, 0, 0], B0 = [Math.cos(b) * r0, 0, Math.sin(b) * r0, 0, 0];
    const A1 = [Math.cos(a) * r1, 1, Math.sin(a) * r1, 0, 1], B1 = [Math.cos(b) * r1, 1, Math.sin(b) * r1, 0, 1];
    tri(A0, A1, B1); tri(A0, B1, B0);
  }
  const R = 0.22, LON = far ? 5 : 8, LAT = far ? 3 : 4;
  const P = (lo, la) => {
    const th = (lo / LON) * 6.2831853, ph = (la / LAT) * Math.PI;
    const y = Math.cos(ph), s = Math.sin(ph);
    return [Math.cos(th) * s * R, y * R, Math.sin(th) * s * R, 1, y * 0.5 + 0.5];
  };
  for (let lo = 0; lo < LON; lo++) for (let la = 0; la < LAT; la++) {
    const a = P(lo, la), b = P(lo + 1, la), c = P(lo + 1, la + 1), d = P(lo, la + 1);
    if (la > 0) tri(a, b, c);
    if (la < LAT - 1) tri(a, c, d);
  }

  ctx.instances({ layout: { polar: "float32x4" }, bounds: { min: [-90, 0, -90], max: [90, 5, 90] } });
  let row = 0;
  for (let r = 8; r <= 88.01; r += 2.5, row++) {
    const n = Math.round((6.2831853 * r) / 1.62);
    for (let k = 0; k < n; k++) {
      const ang = ((k + (row % 2) * 0.5) / n) * 6.2831853;
      const x = Math.cos(ang) * r, z = Math.sin(ang) * r;
      let mul = 1;
      if (z < 20 && z > -34 && Math.abs(x) < 2.5) { if (Math.abs(x) < 1.3 || k % 2) continue; mul = 0.3; }
      ctx.instance([r, ang, row, mul]);
    }
  }
  return { uvs };
}
export function collider() { return null; }
