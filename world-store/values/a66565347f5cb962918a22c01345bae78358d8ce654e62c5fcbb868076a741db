

import { float, vec3, floor, fract, mod, step, smoothstep, length, varying, mix, abs, positionLocal, positionGeometry, instanceIndex } from "builtin/tsl";
import { MeshBasicNodeMaterial, DoubleSide, AdditiveBlending } from "builtin/three";
import { tripClock, pal } from "./lib/trip.js";
import { inside, LY, LZ, breath, fam, light, cut, deal, pinch } from "./tunnel-lib.js";

export function material(ctx) {
  const m = new MeshBasicNodeMaterial();
  const c = tripClock(ctx), F = fam(c);
  const i = float(instanceIndex), ring = floor(i.div(16)), spoke = mod(i, 16);

  const hs = deal(c, 1).mul(step(60.35, c.sec)).mul(step(c.sec, 84.35));
  const dd = fract(ring.div(25).sub(c.sec.div(mix(100, 8, hs)))).mul(300);
  const ang = spoke.div(16).add(ring.mul(0.031)).add(mod(ring, 2).mul(2).sub(1).mul(c.dir).mul(c.phrase).div(8)).mul(6.2831853);
  const Lv = light(c, dd);
  const rad = float(3.3).add(c.rnd(37).mul(1.6)).mul(pinch(c, dd).s);
  const size = float(0.16).mul(float(1).add(breath(c).mul(0.04)).add(Lv.ring.mul(0.5)));
  m.positionNode = vec3(ang.cos().mul(rad).add(positionLocal.x.mul(size).mul(mix(1, 0.35, hs))), ang.sin().mul(rad).add(LY).add(positionLocal.y.mul(size).mul(float(1).sub(hs))), float(LZ).sub(dd).add(positionLocal.y.mul(hs).mul(9)));
  const vd = varying(dd), vL = varying(Lv.L);
  const gl = length(positionGeometry.xy), vh = varying(hs);
  const dot = mix(step(gl, 0.5).mul(step(0.24, gl)), step(abs(positionGeometry.x), 0.5), vh).mul(smoothstep(0, 6, vd)).mul(smoothstep(300, 290, vd));
  const sc = mix(F.acc, pal(F.H.add(positionGeometry.y.mul(0.18))).mul(2.2), vh);
  m.colorNode = sc.mul(dot).mul(inside().mul(cut(c))).mul(float(0.08).add(vL.mul(0.7)).max(vh.mul(0.8))).mul(smoothstep(192, 186, c.sec));
  m.transparent = true;
  m.blending = AdditiveBlending;
  m.depthWrite = false;
  m.side = DoubleSide;
  m.fog = false;
  return m;
}
